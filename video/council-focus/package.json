{
  "name": "counted-council-focus-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "render": "remotion render src/index.ts CouncilFocus out/counted-councils-4x3.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2 && node scripts/finalize.mjs",
    "poster": "remotion still src/index.ts CouncilFocus out/counted-councils-cover.png --frame=900",
    "studio": "remotion studio src/index.ts --no-open",
    "audio": "python3 scripts/create-audio.py",
    "preview": "node scripts/prepare-preview.mjs",
    "source": "python3 scripts/package-source.py"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "6.0.3",
    "ffmpeg-static": "^5.3.0"
  }
}
