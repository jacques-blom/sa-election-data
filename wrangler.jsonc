{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sa-election-data",
  "account_id": "1644a80d2d9ee897e4a990ce1e8100ee",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "r2_buckets": [
    { "binding": "MAP_TILES", "bucket_name": "sa-election-map-tiles" },
    { "binding": "RAW_RESULTS", "bucket_name": "sa-election-data-raw" }
  ],
  "d1_databases": [
    {
      "binding": "RESULTS_DB",
      "database_name": "sa-election-data",
      "database_id": "95ad93f9-e5f0-4a0e-b7c2-74bde7e3b91b",
      // Keep the existing local emulator data separate from the production database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Local UI development reads the live result store. Geography is still only
  // loaded in the local emulator, so keep it on the existing local database.
  "env": {
    "live": {
      "d1_databases": [
        {
          "binding": "RESULTS_DB",
          "database_name": "sa-election-data",
          "database_id": "95ad93f9-e5f0-4a0e-b7c2-74bde7e3b91b",
          "remote": true
        },
        {
          "binding": "GEOGRAPHY_DB",
          "database_name": "sa-election-data",
          "database_id": "95ad93f9-e5f0-4a0e-b7c2-74bde7e3b91b",
          "preview_database_id": "00000000-0000-0000-0000-000000000000",
          "remote": false
        }
      ],
      "r2_buckets": [
        { "binding": "MAP_TILES", "bucket_name": "sa-election-map-tiles", "remote": false },
        { "binding": "RAW_RESULTS", "bucket_name": "sa-election-data-raw", "remote": true }
      ]
    }
  },
  // Jacques's personal profile is scoped to Blom Media LLC.
  // Astro generates the production entrypoint and static-assets configuration.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.01 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
