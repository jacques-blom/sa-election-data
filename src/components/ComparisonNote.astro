---
import type { Result } from '../lib/places/results.ts';
import { combinedOnly, previousElection, type VoteBasis } from '../lib/history/comparison.ts';
interface Props { result: Result; basis?: VoteBasis; compact?: boolean }
const { result, basis = 'source_total', compact = false } = Astro.props;
const previous = previousElection(result.year);
const fallback = basis !== 'source_total' && result.previous && combinedOnly(result.previous);
---
{previous && <p class="comparison-note">{result.previous ? <>Change since {previous} (percentage points).{fallback && ' Compared with combined ballots.'}{!compact && !['national','province'].includes(result.level) && ' Not adjusted for boundary changes.'}</> : <>{previous} comparison unavailable.</>}</p>}
