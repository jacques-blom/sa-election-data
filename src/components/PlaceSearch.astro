---
import Icon from './Icon.astro';
import '../styles/place-search.css';
import { electionYear, latestYear } from '../lib/history/comparison.ts';
import { addressSearchBounds } from '../lib/address/scope.ts';

interface Props {
  id: string;
  mode?: 'area' | 'address' | 'all';
  query?: string;
  action?: string;
  area?: { name: string; bbox: [number, number, number, number] };
  compact?: boolean;
  disabled?: boolean;
  presentation?: 'inline' | 'header' | 'dialog';
  placeholder?: string;
  mobilePlaceholder?: string;
  mobileInline?: boolean;
  directoryHref?: string;
  directoryLabel?: string;
}
const { id, mode = 'area', query = '', action = '/#search-heading', area, compact = false, presentation = 'inline' } = Astro.props;
const routeYear = Astro.url.pathname.match(/^\/(\d{4})(?:\/|$)/)?.[1];
const searchYear = electionYear(routeYear ?? (Astro.url.pathname === '/search' ? Astro.url.searchParams.get('year') ?? undefined : undefined)) ?? latestYear;
const disabled = Astro.props.disabled ?? (mode === 'address' && searchYear !== latestYear);
const configured = !!import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
const label = area ? `Find a place or address around ${area.name}` : 'Find a place or address in South Africa';
const bounds = addressSearchBounds(area?.bbox);
const directoryHref = Astro.props.directoryHref ?? (Astro.url.pathname === '/search' ? '#area-directory' : '/search#area-directory');
const directoryLabel = Astro.props.directoryLabel ?? 'Browse the area directory';
---
<div id={`${id}-search`} data-search-year={searchYear} data-search-disabled={String(disabled)} aria-disabled={disabled ? "true" : undefined} class:list={['place-search', `place-search--${presentation}`, { 'place-search--compact': compact }]} data-place-search data-mobile-placeholder={Astro.props.mobilePlaceholder} data-mobile-inline={Astro.props.mobileInline} data-presentation={presentation} data-mode={mode} data-configured={String(configured)} data-search-bbox={bounds ? JSON.stringify(area?.bbox) : undefined} data-search-area={bounds ? area?.name : undefined}>
  {presentation === 'dialog' && <a class="header-search-trigger" href="/search" data-search-open aria-disabled={disabled ? "true" : undefined} tabindex={disabled ? -1 : undefined} title={disabled ? `Search is available for the ${latestYear} election` : undefined} aria-label="Search places and addresses" aria-haspopup="dialog" aria-controls={`${id}-dialog`}><Icon name="search" size={20}/></a>}
  <div data-search-home hidden={presentation === 'dialog'} tabindex="-1">
    <form class="place-search-form" action={searchYear===latestYear?action:"/search"} method="get" role="search">
      <label class="sr-only" for={id}>{label}</label>
      {bounds && <div class="place-search-scope" data-search-scope hidden={!configured}><span data-search-scope-label>Around {area?.name}</span><button type="button" data-search-scope-toggle disabled={disabled} aria-pressed="false">Search all South Africa</button></div>}
      <div class="place-search-control">
      <div class="place-search-field">
        {presentation === 'header' && <a class="place-search-back" href="/" aria-label="Back to results"><Icon name="arrowLeft" size={20}/></a>}
        <Icon name="search" class="place-search-icon" size={20}/>
        <input disabled={disabled} id={id} type="search" value={query} placeholder={Astro.props.placeholder ?? (searchYear === latestYear ? 'Town, suburb, municipality or address' : 'Town, suburb or municipality')} maxlength="200" autocomplete="off" spellcheck="false" enterkeyhint="search" aria-describedby={`${id}-hint`}/>
        <button class="place-search-clear" type="button" aria-label="Clear search" data-search-clear disabled={disabled} hidden={!query}><Icon name="x" size={18}/></button>
        <button class="button primary place-search-submit" type="submit" disabled={disabled} aria-label="Search"><span class="place-search-submit-label">Search</span> <Icon name="arrowUpRight" size={16}/></button>
      </div>
      <div class="place-search-panel" data-search-panel hidden>
        <p class="place-search-message" data-search-message></p>
        <slot name="results-action"/>
        <ul class="place-search-options" id={`${id}-options`} role="listbox" aria-label="Suggested places and addresses"></ul>
        <a class="place-search-fallback" href={directoryHref}>{directoryLabel} <Icon name="arrowRight" size={14}/></a>
        <div class="place-search-attribution" data-search-attribution hidden><span class="google-maps-attribution" translate="no">Google Maps</span></div>
      </div>
      </div>
      <input type="hidden" name="year" value={searchYear}/>
      <p class="sr-only" data-search-announcement role="status" aria-live="polite" aria-atomic="true"></p>
      <p class="place-search-hint" id={`${id}-hint`} hidden={!disabled && (configured || searchYear !== latestYear)}><span data-search-disabled-hint hidden={!disabled}>Search is available for the {latestYear} election.</span><span data-search-enabled-hint hidden={disabled}>{!configured && searchYear === latestYear && 'Search by place name.'}</span></p>
    </form>
  </div>
  <dialog id={`${id}-dialog`} class="place-search-dialog" aria-labelledby={`${id}-dialog-title`}>
    <header class="place-search-dialog-header"><button class="place-search-back" type="button" data-search-close><Icon name="arrowLeft" size={16}/> Back</button><h2 id={`${id}-dialog-title`}>Find local results</h2></header>
    <div class="place-search-dialog-content" data-search-mobile></div>
    <slot name="result"/>
    <a class="place-search-directory" href={directoryHref}>{directoryLabel} <Icon name="arrowRight" size={14}/></a>
  </dialog>
</div>
<script>import '../lib/address/autocomplete.ts';</script>
