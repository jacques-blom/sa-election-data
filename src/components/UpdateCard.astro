---
import { feedUrl, type Update } from '../lib/updates/feed.ts';
import { cleanName, resultHref, coalitionHref, updateLabel, updateTitle, milestoneTitle, sastTime } from '../lib/updates/presentation.ts';
import { formatNumber, formatTime, partyStyle } from '../lib/places/format.ts';
import { provinces } from '../lib/overview/results.ts';
import PartyLogo from './PartyLogo.astro';
interface Props { update: Update; simulationStep?: number }
const { update, simulationStep } = Astro.props;
const simulated = simulationStep !== undefined;
const eventUrl = (id: number) => feedUrl({ event: id }, '/updates', simulationStep);
const result = update.after;
const province = provinces.find(p => p.id === update.province_id);
const winner = result?.winner;
const seatsWon = winner ? result?.seats?.find(p => p.id === winner.id)?.count : null;
const evidenceUrl = feedUrl({ event: update.id }, '/api/v1/updates', simulationStep);
const builderUrl = simulated ? null : coalitionHref(update);
---
<article class:list={['update-card', { 'update-card--correction': update.action !== 'announced', 'update-card--superseded': !!update.superseded_by }]} id={`update-${update.id}`}>
  <div class="update-card-top"><span class="update-kind">{simulated && 'Simulated · '}{updateLabel(update)}</span><a class="update-time" href={eventUrl(update.id)} aria-label={`Permanent link to ${simulated ? 'simulated ' : ''}update ${update.id}, ${formatTime(update.published_at)}`}><time datetime={update.published_at}>{sastTime(update.published_at)}</time><span> SAST ↗</span></a></div>
  <p class="update-location">{cleanName(update.municipality_name)} <span aria-hidden="true">·</span> {province?.name}</p>
  <div class="update-title-row">{winner && <PartyLogo party={{ party_id: winner.id }}/>}<h3>{updateTitle(update)}</h3></div>
  {update.superseded_by && <p class="update-revision"><a href={eventUrl(update.superseded_by)}>Read the correction →</a></p>}
  {update.action === 'withdrawn' ? <p class="update-description">The latest IEC figures no longer support the previously reported {update.kind === 'ward_won' ? 'ward winner' : update.kind === 'count_complete' ? 'completed count' : 'council allocation'}.</p> : <>
    {result?.kind === 'ward_won' && ((winner?.candidate && winner.id !== '0') || (result.marginVotes != null && result.marginVotes > 0)) && <p class="update-description">{winner?.candidate && winner.id !== '0' && `${winner.candidate}. `}{result.marginVotes != null && result.marginVotes > 0 && <><strong>{formatNumber(result.marginVotes)} votes</strong> ahead.</>}</p>}
    {result?.kind === 'count_complete' && <p class="update-description">All <strong>{formatNumber(result.districts!)} voting districts</strong> have reported.</p>}
    {result?.kind === 'council_decided' && <>
      <p class="update-description">{winner ? <><strong>{formatNumber(seatsWon!)} of {formatNumber(result.totalSeats!)} council seats</strong>.</> : <><strong>{result.majority} seats</strong> needed for a majority.</>}</p>
      <div class="update-seat-bar" aria-hidden="true">{result.seats?.map(p => <span style={`flex:${p.count};background:${partyStyle(p.name)[1]}`}></span>)}</div>
      <details class="update-seat-details"><summary>View the {result.totalSeats}-seat allocation</summary><ul>{result.seats?.map(p => <li><span>{p.id === '0' ? 'Independent candidates (combined)' : partyStyle(p.name)[0]}</span><strong>{p.count} seats</strong></li>)}</ul></details>
    </>}
  </>}
  {update.previous_event_id && <p class="update-previous"><a href={eventUrl(update.previous_event_id)}>View the earlier announcement →</a>{update.before && <span>Previously: {milestoneTitle(update.before)}.</span>}</p>}
  <div class="update-card-bottom"><a class:list={['update-results-link', { 'update-builder-link': !!builderUrl }]} href={simulated ? eventUrl(update.id) : builderUrl ?? resultHref(update)}>{simulated ? 'View simulated update' : builderUrl ? 'Build a majority' : 'View latest results'} <span aria-hidden="true">{builderUrl ? '→' : '↗'}</span></a><span>{simulated ? 'Fictional results' : 'Provisional'}</span></div>
  <details class="update-source"><summary>{simulated ? 'Example timing & data' : 'Source & timing'}</summary><dl><div><dt>{simulated ? 'Example report' : 'IEC report'}</dt><dd><time datetime={update.reported_at}>{formatTime(update.reported_at)}</time></dd></div><div><dt>{simulated ? 'Example observation' : 'Observed by Counted'}</dt><dd><time datetime={update.observed_at}>{formatTime(update.observed_at)}</time></dd></div><div><dt>{simulated ? 'Example publication' : 'Published here'}</dt><dd><time datetime={update.published_at}>{formatTime(update.published_at)}</time></dd></div></dl><p>{simulated ? 'All figures and times in this card are fictional.' : 'These timestamps do not identify when the last vote was counted.'}</p><div class="links">{!simulated && <a href={update.source_url}>IEC source ↗</a>}<a href={evidenceUrl}>{simulated ? 'Simulation data ↗' : 'Saved update data ↗'}</a></div></details>
</article>
