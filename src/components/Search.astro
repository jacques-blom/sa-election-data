---
import PlaceSearch from './PlaceSearch.astro';
import AddressResult from './AddressResult.astro';
const { query = '' } = Astro.props;
---
<section data-address-lookup>
  <PlaceSearch id="directory-search" mode="all" query={query}/>
  <AddressResult/>
</section>
<noscript><form class="search-form" action="/search" method="get" role="search"><label for="directory-query">Find an area by name</label><div class="search-box"><input id="directory-query" name="q" type="search" value={query} maxlength="100"/><button class="button primary" type="submit">Search ↗</button></div></form></noscript>
