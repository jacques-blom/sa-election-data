---
import PartyRow from '../PartyRow.astro';
import OtherParties from '../OtherParties.astro';
import ShareView from './ShareView.astro';
import ResultStatus from '../ResultStatus.astro';
import { resultShareCard } from '../../lib/sharing/results.ts';
import { summaryBallot } from '../../lib/overview/results.ts';
import { formatNumber, type Result } from '../../lib/places/results.ts';
interface Props { result: Result; name: string; compact?: boolean }
const { result, name, compact = false } = Astro.props;
const Heading = compact ? 'h3' : 'h2';
const ballot = summaryBallot(result);
const visibleParties = compact ? 3 : 7;
const remaining = ballot.parties.slice(visibleParties);
const unlisted = ballot.unlisted !== null && ballot.unlisted > 0 ? ballot.unlisted : null;
---
<section class:list={['card overview-vote-summary', { 'home-overall compact-result': compact }]} aria-label={`${name} party vote shares`}>
  <div class="overview-vote-heading"><div>{!compact && <p class="eyebrow">{name}</p>}<Heading>Party vote shares</Heading></div><ShareView card={resultShareCard(result, name)}/></div>
  <p class="overview-ballot-caption">Ward + municipal PR votes</p>
  <ResultStatus result={result}/>
  {ballot.parties.slice(0,visibleParties).map(p => <PartyRow party={p}/>)}
  {(remaining.length > 0 || unlisted !== null) && <OtherParties votes={[...remaining.map(p => p.votesForBallot), ...(unlisted !== null ? [unlisted] : [])]} total={ballot.total} expandable={remaining.length > 0}>
    {remaining.map(p => <PartyRow party={p}/>)}
    {unlisted !== null && <div class="overview-unlisted"><span>Unlisted parties</span><strong>{(unlisted / ballot.total! * 100).toFixed(1)}%<small>{formatNumber(unlisted)} votes</small></strong></div>}
  </OtherParties>}
  {ballot.total === null && <p class="notice">Published figures don’t support reliable vote shares.</p>}
  {ballot.total === 0 && <p class="notice">No votes have been published yet.</p>}
  {ballot.discrepancy !== null && <details class="overview-vote-note"><summary>Source totals differ by {formatNumber(Math.abs(ballot.discrepancy))} votes</summary><p>Percentages use the IEC’s reported valid-ballot total. This small difference does not change the shares rounded to one decimal place.</p></details>}
  {ballot.partial && result.level === 'province' && <p class="overview-vote-note">Selected parties shown</p>}
</section>
