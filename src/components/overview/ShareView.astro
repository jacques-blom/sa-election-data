---
import type { ShareCard } from '../../lib/sharing/model.ts';
interface Props { card: ShareCard; ballot?: 'pr' | 'ward' }
const { card, ballot } = Astro.props;
---
<button type="button" class="button share-trigger" data-share-result={JSON.stringify(card)} data-share-ballot={ballot} aria-haspopup="dialog">Share ↗</button>
