---
import CardCollection from '../CardCollection.astro';
import ChaosPromo from '../ChaosPromo.astro';
import Icon from '../Icon.astro';
import AreaHeader from '../AreaHeader.astro';
import ElectionResults from '../ElectionResults.astro';
import ResultStory from '../ResultStory.astro';
import ResultDetails from '../ResultDetails.astro';
import RelatedNews from '../RelatedNews.astro';
import PartyMovement from '../PartyMovement.astro';
import { partyMovement, latestYear, nationalUrl } from '../../lib/history/comparison.ts';
import Site from '../../layouts/Site.astro';
import PartyLogo from '../PartyLogo.astro';
import ReportingStatus from '../ReportingStatus.astro';
import { env } from 'cloudflare:workers';
import ProvinceResultsMap from '../overview/ProvinceResultsMap.astro';
import PlaceSearch from '../PlaceSearch.astro';
import AddressResult from '../AddressResult.astro';
import MetroResults from '../overview/MetroResults.astro';
import SummaryResults from '../overview/SummaryResults.astro';
import VoteHistory from '../VoteHistory.astro';
import { searchDirectory } from '../../lib/places/directory.ts';
import ProvinceShape from '../overview/ProvinceShape.astro';
import { getNationalOverview, provinces, provinceUrl, progressOf, summaryBallot, overviewPartyStyle, matchesMunicipality } from '../../lib/overview/results.ts';
import { placeUrl } from '../../lib/places/catalogue.ts';
import '../../styles/overview.css';
import '../../styles/home.css';
interface Props { year?: number; data: Awaited<ReturnType<typeof getNationalOverview>> | null }
const year = Astro.props.year ?? latestYear;
const { data } = Astro.props;
const query = (Astro.url.searchParams.get('q') ?? '').slice(0,100).trim();
let directory:Awaited<ReturnType<typeof searchDirectory>>={places:[],total:0};
if(query && year === latestYear)try{directory=await searchDirectory(env.GEOGRAPHY_DB??env.RESULTS_DB,query,12);}catch{}
const knownPlaces=directory.places;
const knownMunicipalities = knownPlaces.flatMap(p => p.relationships.filter(r => r.level === 'municipality' && r.relation === 'equals' && r.election === 2026).map(r => r.areaId));
const matches = query ? data?.municipalities.filter(m => matchesMunicipality(m,query) && !knownMunicipalities.includes(m.id)) ?? [] : [];
const provinceMatches = query ? provinces.filter(p => p.name.toLowerCase().includes(query.toLowerCase()) || p.code.toLowerCase() === query.toLowerCase()) : [];
const searchCount = knownPlaces.length + matches.length + provinceMatches.length;
// Stats SA mid-year population estimates, 2025: https://www.statssa.gov.za/publications/P0302/P03022025.pdf
const provincePopulation = {
  GT: 16_104_933,
  KZN: 12_232_247,
  WC: 7_627_688,
  EC: 7_090_788,
  LIM: 6_366_192,
  MP: 5_076_133,
  NW: 4_183_947,
  FS: 3_039_834,
  NC: 1_379_183,
} satisfies Record<typeof provinces[number]['code'], number>;
const entries = [...(data?.provinces ?? provinces.map(province => ({ province, result:null })))]
  .sort((a, b) => provincePopulation[b.province.code] - provincePopulation[a.province.code]);

---
<Site liveResults={year === latestYear && Astro.response.status !== 404} title={`South African local election results ${year}`} description={`See party vote shares in the ${year} South African local elections. Find municipality and ward results across all nine provinces.`} noindex={!data || !!query} canonicalPath={nationalUrl(year)}>
  <AreaHeader name="South Africa" scope="Local elections" year={year} level="national" areaId="ZA"/>
  <section id="home-search" class="home-search" data-address-lookup aria-label="Find local results">
    <label class="home-search-callout" for="overview-search"><Icon name="mapPin" size={18}/><span>Find what changed in your area</span><Icon name="arrowDownRight" size={18}/></label>
    <PlaceSearch id="overview-search" mode="all" query={query}/>
    <AddressResult/>
    <noscript><p class="small">For place search without JavaScript, <a href="/search">search by name</a>.</p></noscript>
  </section>
  {query && <section class="overview-search-results" aria-labelledby="search-heading"><div class="overview-section-heading"><div><h2 id="search-heading">Results for “{query}”</h2><p>{searchCount} {searchCount === 1 ? 'match' : 'matches'}</p></div><a href={nationalUrl(year)} class="button">Clear search</a></div>
    {searchCount > 0 ? <CardCollection id="search-cards" label="places"><div class="overview-search-grid" data-card-grid>
      {provinceMatches.map(p => <a href={provinceUrl(p,year)}><span class="eyebrow">Province</span><strong>{p.name}</strong></a>)}
      {knownPlaces.map(p => <a href={placeUrl(p,year)}><span class="eyebrow">{p.province} · {p.kind}</span><strong>{p.name}</strong></a>)}
      {matches.map(m => <a href={m.placeHref ?? m.href}><span class="eyebrow">{provinces.find(p=>p.id===m.provinceId)?.name} · {m.code}</span><strong>{m.name}</strong></a>)}
    </div></CardCollection> : <p class="overview-empty">No matches. Try another place or address.</p>}
    {directory.total>12&&<p><a href={`/search?q=${encodeURIComponent(query)}`}>See all {directory.total} area matches <Icon name="arrowRight" size={14}/></a></p>}
    {!data && <p class="overview-warning">Municipality search is temporarily unavailable.</p>}
  </section>}
  {data?.national && <ResultStory result={data.national}/>}
  <ElectionResults year={year} level="national" areaId="ZA">
    {data?.national ? <SummaryResults result={data.national} name="South Africa" compact/> : <p class="notice">Results are temporarily unavailable.</p>}
  </ElectionResults>
  {year === latestYear && !query && <ChaosPromo featured/>}
  {data?.national && <VoteHistory result={data.national}/>}
  <div class="explore-section-heading"><h2>Go closer</h2><a href="#provinces">Nine provinces <Icon name="arrowDownRight" size={16}/></a></div>
  <div id="home-results" class="home-results home-explore"><ProvinceResultsMap entries={entries} year={year} compact/><MetroResults entries={data?.metros} year={year}/></div>
  <section id="provinces" class="overview-provinces" aria-labelledby="province-heading"><div class="overview-section-heading"><div><h2 id="province-heading">Provinces</h2></div></div>
    <CardCollection id="province-cards" label="provinces" collapsible={false}><div class="overview-province-grid" data-card-grid>{entries.map(({province,result}) => {
      const ballot = result ? summaryBallot(result) : null;
      const top = ballot?.topShown;
      const p = result ? progressOf(result) : null;
      return <a class="overview-province-card overview-province-result" href={provinceUrl(province,year)}>
        <div class="overview-province-card-heading"><h3>{province.name}</h3><ProvinceShape province={province} color={top ? overviewPartyStyle(top.party_name)[1] : undefined}/></div>
        {!top && <p class="small">{ballot?.tied ? 'Tied lead' : ballot?.total === 0 ? 'Awaiting votes' : 'Lead unavailable'}</p>}
        <div class="overview-province-bars" aria-label="Parties in the IEC summary">{ballot?.parties.slice(0,3).map(p => <div><span class="party-identity party-identity--compact" title={p.party_name}><PartyLogo party={p} size="small"/><span class="party-identity-text">{overviewPartyStyle(p.party_name)[0]}</span></span><i aria-hidden="true"><b style={`width:${p.share ?? 0}%;background:${overviewPartyStyle(p.party_name)[1]}`}></b></i><span>{p.share === null ? '—' : p.share.toFixed(1)+'%'}{result && <PartyMovement movement={partyMovement(result,p,'source_total')}/>}</span></div>)}</div>
        <p class="overview-province-card-foot"><span hidden={year !== latestYear}>{p ? <ReportingStatus progress={p}/> : 'Reporting progress unavailable'}</span><Icon name="arrowUpRight" size={16}/></p>
      </a>;
    })}</div></CardCollection>
  </section>
  {year === latestYear && <details class="result-breakdown"><summary><span class="detail-icon"><Icon name="news" size={16}/></span><span>Election news</span><Icon name="plus" class="detail-plus"/></summary><RelatedNews scope="national"/></details>}
  {data?.national && <ResultDetails result={data.national}/>}
</Site>
