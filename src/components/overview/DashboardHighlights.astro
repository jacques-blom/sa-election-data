---
import CardCollection from '../CardCollection.astro';
import type { CouncilDashboard } from '../../lib/overview/dashboard.ts';
import GovernmentNote from '../GovernmentNote.astro';
import { partyStyle, formatNumber } from '../../lib/places/format.ts';
import { wardNumber } from '../../lib/places/catalogue.ts';
import { latestYear } from '../../lib/history/comparison.ts';
import CouncilDeclaration from '../CouncilDeclaration.astro';
import ReportingStatus from '../ReportingStatus.astro';
interface Props { data: CouncilDashboard | null; hidden?: boolean }
const { data, hidden = false } = Astro.props;
const h = data?.highlights;
const previousYear = data?.previousYear ?? 2021;
const majorityLabel = (party: { name: string } | null) => party ? `${partyStyle(party.name)[0]} majority` : 'Hung council';
const wardRace = h?.races[0];
const race = wardRace ?? h?.councilRaces[0];
const watch = h?.watch;
const raceHref = race ? wardRace ? `/${latestYear}/wards/${race.id}` : race.council.href : '';
const raceName = race ? wardRace ? `${race.council.name} · Ward ${wardNumber(race.id)}` : race.council.name : '';
const hasHighlights = !!(h?.changes.length || h?.gains.length || h?.losses.length || race || watch);
---
{hasHighlights && <section class="dashboard-highlights" id="highlights" data-dashboard-highlights hidden={hidden} aria-labelledby="highlights-heading">
  <h2 id="highlights-heading"><a href="/highlights">Highlights</a></h2>
  <CardCollection id="dashboard-highlight-cards" label="highlights"><div class="dashboard-highlight-list" data-card-grid>
    {!!h?.changes.length && <section class="dashboard-highlight highlight-panel highlight-panel--changes" style="--council-declaration-color:var(--highlight-muted)">
      <h3><a href="/highlights#majority-changes">{h.changes.length} majority {h.changes.length === 1 ? 'change' : 'changes'}</a></h3>
      <p class="dashboard-highlight-basis">Seats · since {previousYear}</p>
      <CouncilDeclaration year={latestYear}/>
      <ul>{h.changes.slice(0, 2).map(c => <li><a href={c.href}>{c.name}</a><span>{majorityLabel(c.previousWinner)} → {majorityLabel(c.winner)}</span><GovernmentNote context={c.government} link={false}/></li>)}</ul>
    </section>}
    {!!(h?.gains.length || h?.losses.length) && <section class="dashboard-highlight highlight-panel highlight-panel--movement">
      <h3><a href="/highlights#vote-swings">Biggest moves</a></h3>
      <p class="dashboard-highlight-basis">Ward + PR vote share · Since {previousYear}</p>
      <ul>{[h?.gains[0], h?.losses[0]].filter(Boolean).map(m => m && <li><a href={m.council.href}>{m.council.name}</a><span>{partyStyle(m.party.name)[0]} <strong>{m.delta > 0 ? '+' : '−'}{Math.abs(m.delta).toFixed(1)} <abbr title="percentage points">pp</abbr></strong></span></li>)}</ul>
    </section>}
    {(race || watch) && <section class="dashboard-highlight highlight-panel highlight-panel--race">
      <h3><a href="/highlights#close-races">{race ? 'Closest pending race' : 'Count to watch'}</a></h3>
      {race ? <><p class="dashboard-highlight-basis">{wardRace ? 'Ward votes' : 'Municipal PR votes'}</p><ul><li><a href={raceHref}>{raceName}</a><span><strong>{race.tied ? 'Tied' : `${formatNumber(race.margin)} votes apart`}</strong></span></li></ul><ReportingStatus progress={race.progress}/></>
        : watch && <><ul><li><a href={watch.href}>{watch.name}</a><span>Seats pending</span></li></ul><ReportingStatus progress={watch.progress!}/></>}
    </section>}
  </div></CardCollection>
</section>}
