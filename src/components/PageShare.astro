---
interface Props { result?: boolean; coalition?: boolean }
const { result = false, coalition = false } = Astro.props;
---
<button type="button" class="button primary page-share" data-share-page={coalition ? undefined : result ? 'result' : 'page'} data-coalition-share={coalition ? '' : undefined} disabled={coalition} aria-haspopup="dialog">
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M5 13v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/></svg>
  {coalition ? 'Share scenario' : 'Share'}
</button>
