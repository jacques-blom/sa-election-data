---
import { chatEnabled } from '../lib/chat/availability.ts';
---
{chatEnabled && <aside class="ai-callout" aria-labelledby="ai-callout-heading">
  <div>
    <h2 id="ai-callout-heading">Ask the election data</h2>
    <p>Compare places, explore what changed and see how a coalition adds up. Ask Counted a question and follow the sources behind the answer.</p>
  </div>
  <a class="button primary" href="/chat">Ask Counted <span aria-hidden="true">→</span></a>
</aside>}

<style>
  .ai-callout { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 24px 40px; margin-top: 36px; padding: 28px 112px 28px 32px; border: 1px solid var(--line); border-radius: 20px; background: var(--sage); }
  h2 { font-size: 25px; margin-bottom: 10px; }
  p { max-width: 680px; margin-bottom: 0; font-size: 13px; line-height: 1.7; color: var(--muted); }
  a { flex-shrink: 0; gap: 14px; }
  @media (max-width: 700px) { .ai-callout { flex-direction: column; align-items: start; padding: 24px 24px 80px; gap: 20px; } }
</style>
