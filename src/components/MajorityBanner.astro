---
import ChaosPromo from './ChaosPromo.astro';
import { env } from 'cloudflare:workers';
import { councilSeats, type CouncilSeats } from '../lib/seats/allocation.ts';
import { getBuilderResult } from '../lib/seats/directory.ts';
import { majorityWinner } from '../lib/seats/majority.ts';
interface Props { name?: string; href?: string; featured?: boolean; seats?: CouncilSeats; municipalityId?: string | null }
const { name, href = '/chaos', featured = false, seats, municipalityId } = Astro.props;
let allocation = seats;
let failed = false;
// Ward and voting-district invitations use the parent council's seats, never local votes.
if (!allocation && municipalityId) {
  try {
    const result = await getBuilderResult(env.RESULTS_DB, municipalityId, env.RAW_RESULTS);
    if (result) allocation = councilSeats(result.level, result.results);
  } catch { failed = true; }
}
---
{!failed && !majorityWinner(allocation) && <ChaosPromo name={name} href={href} featured={featured}/>}
