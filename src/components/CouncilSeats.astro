---
import ChaosPromo from './ChaosPromo.astro';
import { electionCouncilSeats } from '../lib/history/seats.ts';
import { majorityWinner } from '../lib/seats/majority.ts';
import { latestYear } from '../lib/history/comparison.ts';
import { ballotResults, partyStyle, type Result } from '../lib/places/results.ts';
import { councilShareCard } from '../lib/sharing/council.ts';
import { governmentCaption, governmentContext } from '../lib/governance/index.ts';
import CouncilSeatRow from './CouncilSeatRow.astro';
import ShareView from './overview/ShareView.astro';
import ResultStatus from './ResultStatus.astro';
import Icon from './Icon.astro';
interface Props { result: Result; href: string; name: string }
const { result, href, name }=Astro.props;
const seats=electionCouncilSeats(result);
const promoMajority=seats.status!=='unavailable'&&majorityWinner(seats)?seats.status:undefined;
const parties=seats.status==='unavailable'?[]:seats.parties.filter(p=>p.count>0);
const votes=ballotResults(result,'source_total');
const share=parties.map(p=>votes.parties.find(v=>v.source_entry_id===p.source_entry_id)?.share??null);
const card=councilShareCard(result,name,seats);
const government=governmentCaption(governmentContext(result.id,result.year));
if(card&&government)card.caption+=`\n\n${government}`;
const historical=result.year!==latestYear;
const visiblePartyCount=3;
const otherParties=parties.slice(visiblePartyCount);
const otherShares=share.slice(visiblePartyCount);
const otherShare=otherShares.every(s=>s!==null)?otherShares.reduce<number>((n,s)=>n+s!,0):null;
---
<section class="card council-seats" aria-label="Council seats" data-seat-status={seats.status}>
  <header class="council-heading"><div><h3>Council seats</h3>{seats.status==='estimated'?<span class="seat-state seat-state--estimate">Estimate</span>:!historical&&seats.status==='reported'&&<span class="seat-state">Provisional</span>}</div>{card&&<ShareView card={card}/>}</header>
  <ResultStatus result={result} showProgress={seats.status==='estimated'}/>
  {seats.status==='unavailable'?<div class="seats-pending"><Icon name="clock" size={22}/><p>{historical?'Seat allocation unavailable.':'Seat allocation pending.'}<small>The vote breakdown is below.</small></p></div>:<>
    {seats.status==='estimated'&&<p class="seat-estimate-note">From votes counted so far. Final seats may change.</p>}
    <div class="seat-composition" role="img" aria-label={`${seats.total} council seats; ${seats.majority} for a majority. ${parties.map(p=>`${partyStyle(p.party_name)[0]} ${p.count}`).join(', ')}`}>
      <div class="seat-composition-labels"><span>{seats.total} seats</span><strong>{seats.majority} for a majority</strong></div>
      <div class="seat-composition-bar" style={`--majority:${seats.majority/seats.total*100}%`}>
        {parties.map(p=><i style={`width:${p.count/seats.total*100}%;background:${partyStyle(p.party_name)[1]}`} aria-hidden="true"/>)}<b aria-hidden="true"/>
      </div>
    </div>
    {parties.slice(0,visiblePartyCount).map((p,i)=><CouncilSeatRow party={p} total={seats.total} majority={seats.majority} voteShare={share[i]??null}/>)}
    {otherParties.length>0&&<details class="council-more"><CouncilSeatRow summary party={{other:true,count:otherParties.reduce((n,p)=>n+p.count,0)}} total={seats.total} majority={seats.majority} voteShare={otherShare}/>{otherParties.map((p,i)=><CouncilSeatRow party={p} total={seats.total} majority={seats.majority} voteShare={share[i+visiblePartyCount]??null}/>)}</details>}
    {!historical&&<ChaosPromo name={name} href={`${href}/coalition`} majority={promoMajority}/>}
  </>}
</section>
<style>
  .council-seats{padding:calc(var(--council-beadwork-height,0px) + 16px) 18px 16px;border-radius:14px;margin:0;border:1px solid var(--line)}
  .council-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.council-heading>div{display:flex;align-items:center;flex-wrap:wrap;gap:5px 10px}.council-heading h3{font-size:20px;letter-spacing:-.5px;margin:0}.council-heading :global(.share-trigger){display:flex;gap:6px;min-height:44px;padding:8px 10px;font-size:12px}
  .seat-state{font-size:10px;color:var(--muted);padding:4px 7px;border-radius:5px;background:#edf1e4}.seat-state--estimate{background:#f3e4b9;color:#725819}.seat-estimate-note{font-size:12px;line-height:1.5;margin:0 0 12px;color:var(--muted)}
  .seat-composition{margin:0 0 16px}.seat-composition-labels{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;font-size:11px;color:var(--muted)}.seat-composition-labels strong{font-weight:550;color:var(--ink)}
  .seat-composition-bar{display:flex;position:relative;height:24px;background:#e9eddf;border-radius:5px}.seat-composition-bar i{min-width:0}.seat-composition-bar i:first-child{border-radius:5px 0 0 5px}.seat-composition-bar i:nth-last-child(2){border-radius:0 5px 5px 0}.seat-composition-bar b{position:absolute;left:var(--majority);top:-5px;bottom:-5px;border-left:2px solid var(--ink);box-shadow:-1px 0 0 var(--paper),1px 0 0 var(--paper)}
  .council-more>:global(summary){list-style:none}.council-more>:global(summary)::-webkit-details-marker{display:none}.council-more[open]>:global(summary .council-other-toggle svg){transform:rotate(180deg)}
  .council-more :global(.council-party abbr){white-space:normal;overflow-wrap:anywhere}
  .seats-pending{display:flex;gap:12px;align-items:start;color:var(--muted);padding:12px 0}.seats-pending p{margin:0;font-size:14px}.seats-pending small{display:block;font-size:12px;margin-top:6px}
  @media(max-width:360px){.council-seats{padding:calc(var(--council-beadwork-height,0px) + 12px) 14px 12px}.council-heading h3{font-size:18px}.council-heading>div{gap:4px 7px}}
</style>
