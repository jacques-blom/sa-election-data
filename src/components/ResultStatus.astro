---
import { latestYear } from '../lib/history/comparison.ts';
import { progressOf, resultDelay } from '../lib/overview/results.ts';
import type { Result } from '../lib/places/results.ts';
import ReportingStatus from './ReportingStatus.astro';

interface Props { result: Result; showProgress?: boolean; showDelay?: boolean }
const localSnapshot = import.meta.env.DEV && import.meta.env.COUNTED_LOCAL_SNAPSHOT === true;
const { result, showProgress = true, showDelay = !localSnapshot } = Astro.props;
const progress = progressOf(result);
const delay = resultDelay(result);
---
{showProgress && result.year === latestYear && <div class="result-progress">
  {progress ? <ReportingStatus progress={progress} help/> : <p>Reporting progress unavailable</p>}
</div>}
{showDelay && delay && <p class="notice" role="status">{delay}</p>}

<style>
  .result-progress{margin:16px 0;color:var(--muted);font-size:12px;line-height:1.6}
  .result-progress p{margin:0}
</style>
