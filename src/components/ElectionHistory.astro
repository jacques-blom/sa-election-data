---
import Icon from './Icon.astro';
import { env } from 'cloudflare:workers';
import { availableYears } from '../lib/history/results.ts';
import { ELECTIONS } from '../lib/data/catalogue.ts';
import { latestYear, nationalUrl } from '../lib/history/comparison.ts';
interface Props { year: number; level: string; id: string; currentOnly?: boolean; embedded?: boolean; label?: string }
const { year, level, id, currentOnly = false, embedded = false, label = 'Election' } = Astro.props;
let available: number[] = [];
try { available = currentOnly ? [latestYear] : await availableYears(env.RESULTS_DB, level, id); } catch {}
const years: number[] = ELECTIONS.map(e => e.year).filter(y => available.includes(y) || y === year);
const suffix = level === 'national' ? '' : Astro.url.pathname.replace(/^\/\d{4}/, '').replace(/\/$/, '');
const query = new URLSearchParams();
for (const key of ['ballot', 'party', 'metric', 'council']) if (Astro.url.searchParams.has(key)) query.set(key, Astro.url.searchParams.get(key)!);
const href = (value: number) => (suffix ? `/${value}${suffix}` : nationalUrl(value)) + (query.size ? `?${query}` : '');
---
<election-history id="election-history" data-scope={`${level}:${id}`} class:list={['election-history', { 'election-history--embedded': embedded }]} data-current={years.indexOf(year)}>
  <label class="history-select" for="election-year"><span>{label}</span><select id="election-year" aria-label="Election year" disabled={years.length < 2}>{years.map((y,index)=><option value={index} selected={y===year}>{y}</option>)}</select><Icon name="chevronDown" size={16}/></label>
  <output class="sr-only" for="election-year">{year}</output>
  <nav hidden class="history-years" aria-label="Election history">{years.map(y => <a href={href(y)} data-year={y} aria-current={y === year ? 'page' : undefined}>{y}</a>)}</nav>
  <noscript><nav class="history-years" aria-label="Election history">{years.map(y=><a href={href(y)} aria-current={y===year?'page':undefined}>{y}</a>)}</nav></noscript>
  <p data-history-status role="status" aria-live="polite" hidden></p>
</election-history>
<script>import '../lib/history/client.ts';</script>
