---
import { publicUrl } from '../lib/site.ts';
import PageShare from './PageShare.astro';

const serverUrl = publicUrl('/mcp');
const prompts = [
  { id: 'local', title: 'Explore local results', text: 'Use Counted to summarise Johannesburg’s 2026 election results, including party vote shares, counting progress and source links.' },
  { id: 'compare', title: 'Compare elections visually', text: 'Use Counted to generate and display an image comparing party vote-share changes in Witzenberg from 2021 to 2026. Include any gaps or comparison caveats.' },
  { id: 'council', title: 'Explore council majorities', text: 'Use Counted to explore possible council majorities in Cape Town. Clearly distinguish reported seats from estimates.' },
  { id: 'progress', title: 'Follow the count', text: 'Use Counted to find Western Cape municipalities with the most counting still outstanding. Include when the sources were last checked.' },
  { id: 'coalitions', title: 'Try Joburg coalitions', text: 'Use Counted to show three hypothetical coalition scenarios for Johannesburg’s 2026 council, with a seat diagram for each. Which reach a majority? Distinguish reported seats from estimates and do not imply any coalition agreement.' },
  { id: 'metros', title: 'Compare party support', text: 'Use Counted to generate and display an image comparing the DA’s 2026 vote share in Johannesburg, Tshwane and Ekurhuleni. Use the same ballot type and show counting progress and source dates.' },
];
---

<section id="use-with-ai" class="ai-connect" aria-labelledby="ai-heading">
  <div class="ai-intro">
    <p class="eyebrow">Your questions. Counted’s data.</p>
    <h1 id="ai-heading">Use Counted with AI</h1>
    <p>Explore election results in ChatGPT or Claude. Compare places, investigate changes and turn the data into charts.</p>
    <p class="ai-meta">Public, read-only data · No Counted account or API key needed</p>
    <div class="ai-share"><PageShare/></div>
  </div>

  <div class="ai-connection">
    <label for="counted-mcp-url">MCP server URL</label>
    <div class="ai-copy-row">
      <input id="counted-mcp-url" type="url" value={serverUrl} readonly spellcheck="false"/>
      <button class="button" type="button" data-ai-copy="counted-mcp-url" disabled>Copy URL</button>
    </div>
    <p>Choose your assistant below for setup instructions.</p>
  </div>

  <div class="ai-guides">
    <details class="ai-guide" id="ai-chatgpt">
      <summary><span>Set up ChatGPT</span><span class="ai-expand" aria-hidden="true">+</span></summary>
      <div class="ai-steps">
        <ol>
          <li>Open <strong>Plugins</strong>, select <strong>+</strong>, then <strong>Add custom MCP server</strong>.</li>
          <li>Name it <strong>Counted</strong>, paste the server URL above and choose <strong>No authentication</strong>.</li>
          <li>Review the connection details, select <strong>Create as a plugin</strong>, then install it.</li>
          <li>In a new chat, type <strong>@Counted</strong> to select it, then try a prompt below.</li>
        </ol>
        <a class="button primary" href="https://chatgpt.com/plugins" target="_blank" rel="noopener noreferrer" data-ai-open>Open ChatGPT <span aria-hidden="true">↗</span></a>
        <p class="ai-help">Opening ChatGPT also copies the URL when your browser allows it. Setup finishes in ChatGPT. <a href="https://developers.openai.com/api/docs/guides/custom-mcp-server" target="_blank" rel="noopener noreferrer">Official setup guide ↗</a></p>
      </div>
    </details>
    <details class="ai-guide" id="ai-claude">
      <summary><span>Set up Claude</span><span class="ai-expand" aria-hidden="true">+</span></summary>
      <div class="ai-steps">
        <ol>
          <li>Open <strong>Customize → Connectors</strong>, select <strong>+ Add</strong>, then <strong>Add custom connector</strong>.</li>
          <li>Name it <strong>Counted</strong>, paste the server URL above and select <strong>Continue</strong>.</li>
          <li>Review the settings, choose <strong>No sign in</strong> and select <strong>Add</strong>.</li>
          <li>In a new chat, enable Counted under <strong>+ → Connectors</strong>, then try a prompt below.</li>
        </ol>
        <a class="button primary" href="https://claude.ai/customize/connectors" target="_blank" rel="noopener noreferrer" data-ai-open>Open Claude <span aria-hidden="true">↗</span></a>
        <p class="ai-help">Opening Claude also copies the URL when your browser allows it. Setup finishes in Claude. <a href="https://support.claude.com/en/articles/11175166-get-started-with-custom-connectors-using-remote-mcp" target="_blank" rel="noopener noreferrer">Official setup guide ↗</a></p>
      </div>
    </details>
  </div>

  <section class="ai-prompts" aria-labelledby="ai-prompts-heading">
    <h2 id="ai-prompts-heading">Start with a question</h2>
    <p>Copy a prompt, or swap in your own municipality.</p>
    <div class="ai-prompt-grid">{prompts.map(prompt => <div class="ai-prompt">
      <div class="ai-prompt-heading"><h3>{prompt.title}</h3><button class="button" type="button" data-ai-copy={`counted-ai-${prompt.id}`} aria-label={`Copy prompt: ${prompt.title}`} disabled>Copy</button></div>
      <p id={`counted-ai-${prompt.id}`} class="ai-prompt-text">{prompt.text}</p>
    </div>)}</div>
    <p>AI features and custom connections depend on your plan and workspace settings. Check the linked sources and any limitations in the answer.</p>
  </section>
  <div class="ai-bottom"><p id="ai-copy-status" role="status" aria-live="polite"></p><a href="/api#mcp-access">Explore the API & MCP docs →</a></div>
  <noscript><p class="ai-help">Select and copy the URL or prompt manually. The setup guides and links work without JavaScript.</p></noscript>
</section>

<script>
  function enableCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-ai-copy]').forEach(button => { button.disabled = false; });
  }

  async function copyAIText(id: string) {
    const field = document.getElementById(id);
    const status = document.getElementById('ai-copy-status');
    if (!field || !status) return;
    try {
      await navigator.clipboard.writeText(field instanceof HTMLInputElement ? field.value : field.textContent ?? '');
      status.textContent = id === 'counted-mcp-url' ? 'MCP URL copied.' : 'Starter prompt copied.';
    } catch {
      if (field instanceof HTMLInputElement) {
        field.focus();
        field.select();
      } else {
        const range = document.createRange();
        range.selectNodeContents(field);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      status.textContent = 'Copy unavailable. The text is selected so you can copy it manually.';
    }
  }

  document.addEventListener('click', event => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('[data-ai-copy]');
    if (button?.dataset.aiCopy) void copyAIText(button.dataset.aiCopy);
    if (event.target.closest('[data-ai-open]')) void copyAIText('counted-mcp-url');
  });
  enableCopyButtons();
</script>

<style>
  .ai-connect { padding: 32px; border: 1px solid var(--line); border-radius: 24px; background: var(--sage); display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 24px 40px; scroll-margin-top: 24px; }
  .ai-intro .eyebrow { font-size: 10px; margin-bottom: 12px; }
  .ai-intro h1 { font-size: clamp(34px, 4vw, 48px); margin-bottom: 16px; }
  .ai-intro p { font-size: 14px; line-height: 1.7; margin-bottom: 12px; }
  .ai-intro .ai-meta { font-size: 11px; color: var(--muted); margin-bottom: 0; }
  .ai-share { margin-top: 20px; }
  .ai-connection { align-self: center; min-width: 0; }
  .ai-connect label { display: block; font-size: 13px; font-weight: 600; }
  .ai-copy-row { display: flex; align-items: stretch; gap: 8px; margin-top: 10px; }
  .ai-copy-row input { width: 100%; min-width: 0; border: 1px solid #b9c8af; border-radius: 10px; background: var(--paper); color: var(--ink); padding: 12px; font-size: 13px; }
  .ai-copy-row button { flex-shrink: 0; }
  .ai-connect button[hidden] { display: none; }
  .ai-connection > p, .ai-prompts > p { font-size: 12px; line-height: 1.7; color: var(--muted); margin: 10px 0 0; }
  .ai-guides { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
  .ai-guide { min-width: 0; background: var(--paper); border: 1px solid #c5d2bc; border-radius: 14px; }
  .ai-guide summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; font-size: 15px; list-style: none; border-radius: 14px; }
  .ai-guide summary::-webkit-details-marker { display: none; }
  .ai-guide summary:hover { background: #f1f3e9; }
  .ai-expand { font-size: 22px; line-height: 1; font-weight: 400; transition: transform .15s; }
  .ai-guide[open] .ai-expand { transform: rotate(45deg); }
  .ai-steps { padding: 0 20px 20px; }
  .ai-steps ol { margin: 0 0 20px; padding-left: 20px; }
  .ai-steps li { padding-left: 4px; margin-bottom: 12px; font-size: 13px; line-height: 1.7; }
  .ai-steps .button { gap: 12px; }
  .ai-help { margin: 14px 0 0; font-size: 11px; line-height: 1.7; color: var(--muted); }
  .ai-help a { display: inline-block; }
  .ai-prompts { grid-column: 1 / -1; border-top: 1px solid #c5d2bc; padding-top: 24px; min-width: 0; }
  .ai-prompts h2 { font-size: 24px; margin-bottom: 8px; }
  .ai-prompt-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 20px 0; }
  .ai-prompt { min-width: 0; display: flex; flex-direction: column; }
  .ai-prompt-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .ai-prompt-heading h3 { margin: 0; font-size: 13px; font-weight: 600; line-height: 1.5; }
  .ai-prompt-heading button { flex-shrink: 0; }
  .ai-prompt-text { flex: 1; margin: 0; border: 1px solid #c5d2bc; border-radius: 12px; background: var(--paper); color: var(--ink); padding: 16px; font-size: 14px; line-height: 1.7; }
  .ai-bottom { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; font-size: 12px; }
  .ai-bottom p { margin: 0; line-height: 1.6; }
  .ai-bottom a { margin-left: auto; }
  @media (max-width: 800px) { .ai-connect { grid-template-columns: 1fr; gap: 24px; padding: 24px; } }
  @media (max-width: 540px) { .ai-connect { padding: 20px; } .ai-guides, .ai-prompt-grid { grid-template-columns: 1fr; gap: 16px; } .ai-copy-row { flex-wrap: wrap; } .ai-copy-row input { flex-basis: 100%; font-size: 16px; } .ai-prompt-text { font-size: 16px; } .ai-bottom a { margin-left: 0; } }
  @media (prefers-reduced-motion: reduce) { .ai-expand { transition: none; } }
</style>
