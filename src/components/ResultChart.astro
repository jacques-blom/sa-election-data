---
import { combinedOnly as isCombinedOnly, displayBallot, partyMovement } from '../lib/history/comparison.ts';
import PartyRow from './PartyRow.astro';
import OtherParties from './OtherParties.astro';
import ShareView from './overview/ShareView.astro';
import { resultShareCard } from '../lib/sharing/results.ts';
import { governmentContext, governmentCaption } from '../lib/governance/index.ts';
import RaceLead from './RaceLead.astro';
import ResultStatus from './ResultStatus.astro';
import { ballotResults, type Result, type Ballot } from '../lib/places/results.ts';
interface Props { result: Result; ballot: Ballot; tabs?: boolean; name?: string; compact?: boolean }
const { result, ballot, tabs = true, compact = false, name = result.name.replace(/^[A-Z0-9]+\s+-\s+/, '') } = Astro.props;
const Heading = compact ? 'h3' : 'h2';
const combinedOnly = isCombinedOnly(result);
const basis = displayBallot(result, ballot);
const data = ballotResults(result, combinedOnly ? 'source_total' : ballot);
const ballotName = combinedOnly ? 'Combined ballot votes' : ballot === 'pr' ? 'Municipal PR votes' : 'Ward ballot votes';
const initialCount = data.total === 0 ? 0 : compact ? 3 : 7;
const ballotHref = (value: string) => {
  const params = new URLSearchParams([...Astro.url.searchParams].filter(([key])=>['council','party','metric','history-year','ward'].includes(key)));
  params.set('ballot', value);
  return `?${params}#${result.level==='municipality'?'vote-results':'election-results'}`;
};
const shareCard = resultShareCard(result, name, combinedOnly ? 'source_total' : ballot);
const government = result.level === 'municipality' ? governmentCaption(governmentContext(result.id, result.year)) : null;
if (government) shareCard.caption += `\n\n${government}`;
---
<section class:list={['card result-card', {'compact-result':compact}]} aria-label={ballotName}><div class="card-heading"><Heading>{ballotName}</Heading><ShareView card={shareCard} ballot={combinedOnly ? undefined : ballot}/></div>
{tabs && !combinedOnly && <nav class="tabs" aria-label="Ballot type"><a href={ballotHref('pr')} aria-current={ballot === 'pr' ? 'page' : undefined}>Municipal PR</a><a href={ballotHref('ward')} aria-current={ballot === 'ward' ? 'page' : undefined}>Ward ballot</a></nav>}
<ResultStatus result={result}/>
{!compact && <RaceLead data={data} movement={data.leader ? partyMovement(result, data.leader, basis) : null}/>}

{data.total === null && <p class="notice">Some ballot figures are unavailable. Vote shares cannot be calculated reliably.</p>}
{data.total === 0 && <p class="notice">No votes have been published for this ballot yet.</p>}
{data.parties.slice(0,initialCount).map(p => <PartyRow party={p}/>)}
{data.parties.length > initialCount && <OtherParties votes={data.parties.slice(initialCount).map(p => p.votesForBallot)} total={data.total}>{data.parties.slice(initialCount).map(p => <PartyRow party={p}/>)}</OtherParties>}
{result.quality.vote_total_reconciliation.status === 'differs_from_reported_total' && <details class="notice"><summary>Source totals need care</summary><p>The IEC’s combined valid-ballot total differs from the sum of its published party rows. The chart preserves the party figures and calculates shares separately for this ballot.</p></details>}

</section>
