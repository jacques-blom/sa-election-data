---
import type { GuideTopic } from '../lib/education.ts';
interface Props { topic:GuideTopic; index:number }
const {topic,index}=Astro.props;
const geography=['government','ward','voting-district','national','map'].includes(topic);
---
<svg class="guide-picture" viewBox="0 0 120 62" fill="none" aria-hidden="true">
  {topic==='change'&&index===0 ? <>
    <path d="M5 51H115" stroke="#c4ceb7"/>
    <rect x="20" y="22" width="24" height="29" rx="3" fill="#a7b897"/><rect x="76" y="17" width="24" height="34" rx="3" fill="#3d6c52"/>
    <path d="M49 25H69m-5-5 5 5-5 5" stroke="#a17942" stroke-width="2"/>
    <text x="32" y="15" text-anchor="middle">30%</text><text x="88" y="10" text-anchor="middle">35%</text>
  </> : geography ? <>
    <rect x="8" y="4" width="104" height="54" rx="8" stroke="#6c8665" stroke-width="1.5"/>
    {Array.from({length:6},(_,i)=><rect x={17+i%3*30} y={12+Math.floor(i/3)*22} width="26" height="18" rx="3" fill={index===0&&i!==0?'#dce4d1':i%3===0?'#3d6c52':i%3===1?'#a8b892':'#bd965b'}/>)}
    {(topic==='ward'||topic==='voting-district')&&<circle cx="30" cy="21" r="3" fill="#fffdf2"/>}
  </> : topic==='ballots' ? <>
    <rect x="30" y="4" width="60" height="54" rx="5" fill="#fffdf2" stroke="#98ac85"/>
    {index===0 ? <><circle cx="49" cy="19" r="6" fill="#3d6c52"/><path d="M40 38v-4a9 9 0 0 1 18 0v4" fill="#3d6c52"/><path d="m66 28 5 5 10-12" stroke="#b58e4c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></> : <>{[16,29,42].map((y,i)=><><rect x="40" y={y-4} width="8" height="8" rx="2" fill={i===0?'#3d6c52':'#dce4d1'}/><path d={`M55 ${y}h23`} stroke="#98ac85" stroke-width="2"/></>)}</>}
  </> : <>
    <rect x="16" y="30" width="19" height="25" rx="3" fill="#a7b897"/><rect x="50" y="11" width="19" height="44" rx="3" fill="#3d6c52"/><rect x="84" y="23" width="19" height="32" rx="3" fill="#bd965b"/>
    <path d="M8 55h104M8 26h104" stroke="#6c8665" stroke-dasharray="3 3"/>
  </>}
</svg>
<style>.guide-picture{display:block;width:120px;max-width:100%;height:62px;margin-bottom:12px}.guide-picture text{font:9px 'Space Grotesk',sans-serif;fill:#3c5b45}@media(max-width:540px){.guide-picture{width:78px;height:48px;margin:0;grid-column:1;grid-row:1/3}}</style>
