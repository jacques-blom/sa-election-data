---
import Icon from './Icon.astro';
import { governmentHistory, compareGovernmentPartners, memberKeys, supporterKeys, membersLabel, seatSnapshot } from '../lib/governance/index.ts';
import { partyName, partyShort } from '../lib/governance/parties.ts';
import { councilSeats } from '../lib/seats/allocation.ts';
import { partyStyle } from '../lib/places/format.ts';
import type { Result } from '../lib/places/results.ts';
import { electionMajorityBaseline } from '../lib/history/seats.ts';
import { governmentStory } from '../lib/governance/story.ts';
import GovernmentTransition from './GovernmentTransition.astro';
interface Props { municipalityId: string; result?: Result | null; builder?: boolean }
const { municipalityId, result, builder = false } = Astro.props;
const year = result?.year ?? 2026;
const history = governmentHistory(municipalityId, electionMajorityBaseline(year === 2021 ? result : result?.previous));
const government = history && { ...history,
  beforeElection: year === 2026 ? history.beforeElection : null,
  afterElection: year === 2026 ? history.afterElection : null,
};
const record = government?.latest;
const transition = year === 2026 ? governmentStory(government,year) : null;
const majority = government?.majorityAdministration;
const baseline = government?.electionBaseline;
const electionOnly = !record && !majority && !government?.beforeElection && !government?.afterElection;
const comparison = year === 2026 && government ? compareGovernmentPartners(government, seatSnapshot(result ? councilSeats(result.level, result.results) : null)) : null;
const date = (value: string) => new Intl.DateTimeFormat('en-ZA', {day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(value));
const office = (name: string) => ({ Unknown:'Not established', Vacant:'Vacant', None_Designated:'None designated' }[name] ?? name);
---
{government && (record || majority || government.beforeElection || government.afterElection) && <section id="government" class="card council-government" aria-labelledby="government-heading">
  <header><div><p class="eyebrow">Council government</p><h2 id="government-heading">{year === 2021 ? 'Who governed after 2021' : 'Who has governed here'}</h2></div></header>
  {transition&&<GovernmentTransition story={transition} href="#government-evidence"/>}
  <div class="government-timeline" aria-label="Recorded administrations">{record ? government.records.map(r=><div><time>{new Date(r.start).getUTCFullYear()}</time><strong>{membersLabel(memberKeys(r))}</strong><span>{r.end?date(r.end):'Feb 2026'}</span></div>) : majority ? <div><time>2021</time><strong>{partyShort(majority.partyKey)}</strong><span>Single-party majority · {date(majority.evidenceThrough)}</span></div> : null}{government.afterElection&&<div><time>2026</time><strong>{government.label}</strong><span>{date(government.afterElection.effectiveFrom)}</span></div>}</div>
  <details id="government-evidence" class="government-evidence"><summary><span class="detail-icon"><Icon name="landmark" size={16}/></span> Administrations & sources <Icon name="plus" class="detail-plus"/></summary>
  {majority && <div class="confirmed-government"><h3>{partyShort(majority.partyKey)} single-party majority</h3><p><strong>{majority.electionSeats} of {majority.totalSeats} seats</strong> at the 2021 election</p><p>{majority.notes}</p><p class="small">Evidence: {majority.evidencePeriod}, covering the year ended {date(majority.evidenceThrough)}.</p><div class="links">{majority.sources.map(s=><a href={s.url}>{s.title} <Icon name="arrowUpRight" size={13}/></a>)}</div></div>}
  {electionOnly && baseline && <div class="confirmed-government"><h3>{partyStyle(baseline.party.name)[0]} outright majority</h3><p><strong>{baseline.seats} of {baseline.total} seats</strong> in the 2021 council allocation.</p><p class="small">This is the previous election outcome. It does not establish who governed throughout the term or record later changes.</p>{baseline.correction && <p class="small">Includes the <a href={baseline.correction.url}>IEC recount correction of 26 May 2022 <Icon name="arrowUpRight" size={13}/></a>.</p>}<a href={baseline.source.url}>IEC 2021 archived figures <Icon name="arrowUpRight" size={13}/></a></div>}
  {government.afterElection && <div class="confirmed-government"><h3>{government.label}</h3><p>In office from {date(government.afterElection.effectiveFrom)} · verified {date(government.afterElection.verifiedAt)}</p>{government.change.status !== 'unconfirmed' && <p>{government.change.label}</p>}<p>{government.afterElection.notes}</p><div class="links">{government.afterElection.sources.map(s => <a href={s.url}>{s.title} <Icon name="arrowUpRight" size={13}/></a>)}</div></div>}
  {government.afterElection && government.afterElection.supporters.length > 0 && <p class="small"><strong>Outside support:</strong> {membersLabel(government.afterElection.supporters)}</p>}
  {government.beforeElection && <div class="confirmed-government"><h3>Before the 2026 election: {membersLabel(government.beforeElection.members)}</h3><p>Verified {date(government.beforeElection.verifiedAt)} · {government.beforeElection.arrangement}</p>{government.beforeElection.supporters.length > 0 && <p>Outside support: {membersLabel(government.beforeElection.supporters)}</p>}<p>{government.beforeElection.notes}</p><div class="links">{government.beforeElection.sources.map(s=><a href={s.url}>{s.title} <Icon name="arrowUpRight" size={13}/></a>)}</div></div>}
  {record && <p class="government-caution">MISTRA records the administrations that governed after the 2021 election, through 28 February 2026. The latest recorded administration is shown below, followed by its predecessors. Party roles and officeholders are recorded at formation; later changes may appear in the notes.</p>}
  {record && <>
    {(government.afterElection || government.beforeElection) && <h3>Historical administration from MISTRA</h3>}
    <div class="government-partners" aria-label="Recorded members at formation">{memberKeys(record).map(key => <span style={`--party:${partyStyle(partyName(key))[1]}`}><i aria-hidden="true"/><abbr title={partyName(key)}>{partyShort(key)}</abbr></span>)}</div>
    <p class="government-basis">Members at formation · {record.sizeType === 'Minority' ? 'minority administration' : 'majority coalition'} · {record.approximateStart ? 'Around ' : ''}{date(record.start)}{record.end ? ` – ${date(record.end)}` : ' · recorded active at source cutoff'}</p>
    {supporterKeys(record).length > 0 && <p class="small"><strong>Outside support at formation:</strong> {membersLabel(supporterKeys(record))}. Supporters are separate from governing members.</p>}
    <p class="small"><strong>Inaugural mayor:</strong> {office(record.inauguralMayor.name)}{!['Unknown','Vacant','None_Designated',''].includes(record.inauguralMayor.party) && ` (${partyShort(record.inauguralMayor.party)})`}</p>
    {record.notes && <p class="government-source-note"><strong>{record.editorialCorrection ? 'Counted clarification:' : 'Source notes:'}</strong> {record.notes}</p>}
    {record.editorialCorrection && <p class="small">Clarified {date(record.editorialCorrection.reviewedAt)}. Original wording retained in the data. {record.editorialCorrection.sources.map(s => <a href={s.url}>{s.title} ↗ </a>)}</p>}
    {record.issues.length > 0 && <ul class="government-issues">{record.issues.map(issue => <li>{issue}</li>)}</ul>}
  </>}
  {comparison && comparison.status !== 'unavailable' && <div class="government-comparison"><p class="eyebrow">{comparison.basis === 'verified-before-election' ? 'The pre-election partners in 2026' : 'The recorded partners in 2026'}</p>
      <h3>{comparison.total}<small> / {comparison.councilSize} {comparison.status === 'estimated' ? 'estimated ' : ''}seats</small></h3><p>{comparison.shortfall ? `${comparison.shortfall} short of a seat majority` : 'Enough seats for a hypothetical majority'} · {comparison.majority} needed</p><div class="government-track" role="img" aria-label={comparison.label}><i style={`width:${comparison.total / comparison.councilSize * 100}%`}/><b aria-hidden="true"/></div><p class="small">{comparison.caveat}</p>{!builder && <a href={`/2026/places/${government.municipality.slug}/coalition?parties=${comparison.partyIds.join(',')}`}>Test these parties in Coalition Chaos <Icon name="arrowRight" size={14}/></a>}
    </div>}
  {record && <>
    <details class="government-history"><summary>{government.historyCount} recorded {government.historyCount === 1 ? 'administration' : 'administrations'} · 2021–February 2026</summary><ol>{government.records.toReversed().map(r => <li><strong>{membersLabel(memberKeys(r))}</strong><p>{r.approximateStart ? 'Around ' : ''}{date(r.start)} → {r.end ? date(r.end) : 'Active at cutoff'} · {r.end ? r.termination.replaceAll('_',' ') : '28 Feb 2026'}</p><p>Members at formation.{supporterKeys(r).length > 0 && ` Outside support: ${membersLabel(supporterKeys(r))}.`} Inaugural mayor: {office(r.inauguralMayor.name)}.</p>{r.notes && <p>{r.editorialCorrection && <strong>Counted clarification: </strong>}{r.notes}</p>}{r.editorialCorrection && <p class="small">Clarified {date(r.editorialCorrection.reviewedAt)}. {r.editorialCorrection.sources.map(s => <a href={s.url}>{s.title} ↗ </a>)}</p>}{r.issues.map(issue => <p class="government-issues">{issue}</p>)}</li>)}</ol></details>
  </>}
  <footer><a href="/governments">About the government history</a>{record && <> · <a href={government.source.url}>MISTRA, 2026 edition v1.0 <Icon name="arrowUpRight" size={13}/></a><p>Original coalition coding: CC BY 4.0. IEC seat figures and municipal identifiers retain their original terms. Dates and party labels have been normalised. Counted clarifications are labelled and sourced; original wording and source issues are retained in the data.</p></>}</footer>
  </details>
</section>}
<style>
.government-timeline{display:flex;gap:0;overflow-x:auto;padding:8px 0 18px}.government-timeline>div{min-width:170px;flex:1;display:grid;gap:8px;padding:12px 24px 0 0;border-top:3px solid #8c9d7b;position:relative}.government-timeline>div:before{content:"";position:absolute;top:-6px;left:0;width:9px;height:9px;border-radius:50%;background:#44664a}.government-timeline time{font-size:11px;color:var(--muted)}.government-timeline strong{font-size:17px}.government-timeline span{font-size:10px;color:var(--muted)}.government-evidence>summary{display:flex;align-items:center;gap:10px;cursor:pointer;padding:12px 0;font-size:12px;list-style:none}.government-evidence>summary::-webkit-details-marker{display:none}
.council-government{margin:24px 0;border-top:4px solid #7b8064}.council-government header{display:flex;align-items:start;justify-content:space-between;gap:16px}.council-government h2{font-size:24px;margin:4px 0 16px}.government-caution{font-size:13px;line-height:1.65;color:var(--muted);max-width:800px}.government-partners{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}.government-partners>span{display:flex;gap:8px;align-items:center;background:#edf0e5;border-radius:8px;padding:9px 12px;font-weight:600}.government-partners i{background:var(--party);width:9px;height:9px;border-radius:50%}.government-partners abbr{text-decoration:none}.government-basis{font-size:12px;color:var(--muted);line-height:1.6}.government-source-note{font-size:13px;line-height:1.75;border-left:3px solid #c7cdbc;padding-left:14px;white-space:pre-line}.government-issues{font-size:12px;color:#785522;line-height:1.7}.government-comparison{background:#eef0e6;padding:20px;border-radius:12px;margin:22px 0}.government-comparison h3{font-size:32px;margin:8px 0}.government-comparison h3 small{font-size:15px;font-weight:400}.government-comparison p{line-height:1.7}.government-comparison a{font-size:13px}.government-track{position:relative;background:#d7ddcc;border-radius:4px;height:12px;margin:16px 0}.government-track i{display:block;height:100%;background:#567157;border-radius:4px}.government-track b{position:absolute;left:50%;top:-4px;height:20px;border-left:2px dashed #163a30}.government-history summary{padding:12px 0;cursor:pointer;font-size:14px;font-weight:600}.government-history ol{padding-left:20px}.government-history li{padding:14px 0;border-bottom:1px solid #dce1d3}.government-history li p{font-size:12px;line-height:1.7;margin:6px 0;white-space:pre-line}.council-government footer{font-size:11px;line-height:1.7;margin-top:20px;color:var(--muted)}.council-government footer p{margin-bottom:0;max-width:800px}@media(max-width:650px){.council-government header{flex-direction:column;gap:0}.council-government h2{font-size:22px}.government-partners>span{font-size:13px}.government-comparison{padding:16px}}
</style>

