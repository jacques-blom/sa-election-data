---
import Brand from '../components/Brand.astro';
const title = 'Counted · South African election results';
const canonical = new URL('/', Astro.url.origin).href;
---

<html lang="en-ZA">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="An independent project making South African local election results easier to find, understand, and use."
		/>
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:site_name" content="Counted" />
		<meta property="og:description" content="South African election results, made clear." />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content="website" />
	</head>
	<body>
		<main>
			<div class="wordmark"><Brand /></div>
			<p class="status">In development</p>
			<h1>Your area.<br />Your election.<br /><span>A clearer picture.</span></h1>
			<p class="intro">
				We’re building a simpler way to explore South African local election results,
				understand what they mean, and access the data behind them.
			</p>
			<footer>
				An independent civic project. The results explorer is in development.
				<a href="/api">API documentation</a>
			</footer>
		</main>
	</body>
</html>

<style>
	:global(html) {
		font-family: system-ui, sans-serif;
		color: #183d32;
		background: #f6f5ef;
	}
	:global(body) { margin: 0; }
	main { max-width: 64rem; margin: 0 auto; padding: 2.5rem 1.5rem; }
	.wordmark { margin: 0 0 5rem; font-size: 1.125rem; font-weight: 750; }
	.status { font-size: 0.8rem; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; }
	h1 { margin: 1.25rem 0 2rem; font-size: clamp(2.75rem, 8vw, 6rem); line-height: 1.05; letter-spacing: -0.055em; }
	h1 span { color: #386b58; }
	.intro { max-width: 34rem; font-size: 1.125rem; line-height: 1.7; }
	footer { margin-top: 5rem; border-top: 1px solid #ced8cd; padding-top: 1.5rem; color: #4b6258; font-size: 0.875rem; line-height: 1.6; }
	footer a { color: inherit; margin-left: 0.5rem; }
</style>
