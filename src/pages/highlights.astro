---
import CardCollection from '../components/CardCollection.astro';
import ChaosPromo from '../components/ChaosPromo.astro';
import { env } from 'cloudflare:workers';
import Site from '../layouts/Site.astro';
import CivicGuide from '../components/CivicGuide.astro';
import PageShare from '../components/PageShare.astro';
import GovernmentNote from '../components/GovernmentNote.astro';
import CouncilDeclaration from '../components/CouncilDeclaration.astro';
import PartyLogo from '../components/PartyLogo.astro';
import MovementBoard from '../components/highlights/MovementBoard.astro';
import RaceCard from '../components/highlights/RaceCard.astro';
import ReportingStatus from '../components/ReportingStatus.astro';
import SeatChanges from '../components/highlights/SeatChanges.astro';
import DividedCouncils from '../components/highlights/DividedCouncils.astro';
import { getCouncilDashboard, type CouncilDashboard } from '../lib/overview/dashboard.ts';
import { electionHighlights } from '../lib/overview/highlights.ts';
import { councilFilterUrl } from '../lib/overview/dashboard-filter.ts';
import { partyStyle } from '../lib/places/format.ts';
import { latestYear } from '../lib/history/comparison.ts';
import '../styles/highlights.css';
let data: CouncilDashboard | null = null;
try { data = await getCouncilDashboard(env.RESULTS_DB, env.RAW_RESULTS); }
catch (error) { console.error('Election highlights unavailable', error); }
Astro.response.status = data ? 200 : 503;
Astro.response.headers.set('Cache-Control', data ? 'public, max-age=15, s-maxage=15' : 'no-store');
if (!data) Astro.response.headers.set('Retry-After', '60');
const h = data ? electionHighlights(data.councils) : null;
const previousYear = data?.previousYear ?? 2021;
const balanceMax = Math.max(1, ...h?.balance.flatMap(p => [p.gained, p.lost]) ?? []);
const outcomeKey = [{key:'majority',label:'Outright majority'}, {key:'noMajority',label:'Hung council'}, {key:'pending',label:'Seats pending'}, {key:'unavailable',label:'Unavailable'}] as const;
---
<Site title="What changed" description="Majorities gained and lost, the biggest local vote-share swings, close pending races and the councils nearest a majority in South Africa’s 2026 local elections." canonicalPath="/highlights" noindex={!data} liveResults={!!data}>
  <div class="election-insights">
    <header class="insights-header">
      <div class="page-share-heading"><div><p class="eyebrow">{latestYear} local elections</p><h1>What changed</h1></div><PageShare/></div>
      <div class="insights-meta"><a href="/updates">Latest announcements ↗</a></div>
    </header>
    {data && h ? <>
      {(data.delayedCouncils > 0 || data.summaryCoverage < data.total) && <p class="notice">{data.delayedCouncils > 0 && <>Updates delayed for {data.delayedCouncils} councils; showing the last available results. </>}{data.summaryCoverage < data.total && <>Rankings cover {data.summaryCoverage} of {data.total} councils.</>}</p>}
      <section class="insight-topline" aria-label="The election at a glance">
        <a class="insight-stat insight-stat--changes" href="#majority-changes"><span>Majorities changed</span><strong>{h.changes.length}<svg viewBox="0 0 80 60" fill="none" aria-hidden="true"><path d="M5 18h62L54 5m13 13L54 31M75 42H13l13-13M13 42l13 13" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></strong><small>Since {previousYear} · {h.comparable} comparable councils <b aria-hidden="true">↗</b></small></a>
        <a class="insight-stat insight-stat--hung" href="#majority-maths"><span>Hung councils</span><strong>{h.hung}<svg viewBox="0 0 80 60" fill="none" aria-hidden="true"><path d="M5 50V25h16v25M32 50V10h16v40M59 50V31h16v19M0 20h80" stroke="currentColor" stroke-width="3" stroke-dasharray="0"/><path d="M0 20h80" stroke="currentColor" stroke-width="2" stroke-dasharray="3 4"/></svg></strong><small>Of {h.reported} reported council allocations <b aria-hidden="true">↗</b></small></a>
        <a class="insight-stat insight-stat--pending" href="#close-races"><span>Councils still pending</span><strong>{h.pending}<svg viewBox="0 0 80 60" fill="none" aria-hidden="true"><circle cx="42" cy="30" r="24" stroke="currentColor" stroke-width="3" opacity=".35"/><path d="M42 6a24 24 0 0 1 24 24M42 14v17l11 7" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></strong><small>Seat allocations still to be reported <b aria-hidden="true">↗</b></small></a>
      </section>
      <nav class="insight-jumps" aria-label="Highlights sections"><a href="#majority-changes">Majorities & seats</a><a href="#vote-swings">Vote-share changes</a><a href="#close-races">Close races</a><a href="#majority-maths">Majority maths</a><a href="#government-changes">Governments</a><a href="#province-picture">By province</a></nav>

      <section id="majority-changes" class="insight-section" aria-labelledby="majority-changes-title">
        <div class="insight-section-heading"><div><h2 id="majority-changes-title">Majorities and council seats</h2><p>Reported allocations, compared with {previousYear}.</p><CouncilDeclaration year={latestYear}/></div></div>
        <div class="insight-two-up insight-party-charts">
          <article class="insight-panel insight-balance"><h3>Outright majorities gained/lost</h3><p class="insight-caption">Councils where a party gained or lost a seat majority.</p>
            {h.balance.length ? <><div class="insight-balance-key"><span aria-hidden="true"/><span>Lost ←</span><span>→ Gained</span><span>Net</span></div><ul>{h.balance.map(p => <li>
              <span class="insight-party"><PartyLogo party={{party_id:p.id}} size="small"/><abbr title={p.name}>{partyStyle(p.name)[0]}</abbr></span>
              <div class="insight-balance-bars" role="img" aria-label={`${p.lost} lost, ${p.gained} gained`}><span><i style={`width:${p.lost / balanceMax * 100}%`}/>{p.lost > 0 && <b>{p.lost}</b>}</span><span><i style={`width:${p.gained / balanceMax * 100}%`}/>{p.gained > 0 && <b>{p.gained}</b>}</span></div><strong class:list={{'is-gain':p.net>0,'is-loss':p.net<0}} aria-label={`Net ${p.net}`}>{p.net>0?'+':p.net<0?'−':''}{Math.abs(p.net)}</strong>
            </li>)}</ul></> : <p class="insight-empty">No changes in comparable reported allocations yet.</p>}
            <p class="insight-footnote">{h.comparable} councils have reported allocations in both elections. Pending councils are excluded.</p>
          </article>
          <SeatChanges changes={h.seatChanges} previousYear={previousYear}/>
        </div>
        <div class="insight-panel insight-change-summary" role="group" aria-label={`Majority changes since ${previousYear}`}>
          <dl><div><dt>Majority → hung</dt><dd>{h.changesToHung}</dd></div><div><dt>Hung → majority</dt><dd>{h.changesFromHung}</dd></div><div><dt>Party → party</dt><dd>{h.changesBetweenParties}</dd></div></dl>
          <a class="button" href={councilFilterUrl({changed:true})}>View all {h.changes.length} changed councils <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="vote-swings" class="insight-section" aria-labelledby="vote-swings-title">
        <div class="insight-section-heading"><div><h2 id="vote-swings-title">Where the vote moved most</h2><p>Percentage-point changes since {previousYear}, in {h.movementCoverage} comparable completed counts.</p></div><span class="insight-tag">Combined ward + PR ballots</span></div>
        <div class="insight-two-up"><MovementBoard rows={h.gains} kind="gains" previousYear={previousYear}/><MovementBoard rows={h.losses} kind="losses" previousYear={previousYear}/></div>
        <p class="insight-footnote">Each row is one party in one municipality. A party absent from a complete list is counted as 0%. These are local changes, not national party rankings.</p>
      </section>

      <section id="close-races" class="insight-section" aria-labelledby="close-races-title">
        <div class="insight-section-heading"><div><h2 id="close-races-title">Close races still counting</h2><p>Within 2 percentage points, with at least half of districts reporting and counting unfinished.</p></div><a class="insight-text-link" href={councilFilterUrl({status: 'pending'})}>All pending councils →</a></div>
        {h.councilRaces.length > 0 && <CardCollection id="council-races" label="council races"><div class="insight-race-grid" data-card-grid>{h.councilRaces.map(race => <RaceCard race={race}/>)}</div></CardCollection>}
        {h.races.length > 0 && <><h3 class="insight-subheading">Close ward races</h3><CardCollection id="ward-races" label="ward races"><div class="insight-race-grid" data-card-grid>{h.races.map(race => <RaceCard race={race} ward/>)}</div></CardCollection></>}
        {!h.councilRaces.length && !h.races.length && <div class="insight-panel"><h3>No close races still counting</h3>{h.counting.length > 0 && <><h3 class="insight-subheading">Counts to watch</h3><CardCollection id="counting-cards" label="councils"><div class="insight-watch-grid" data-card-grid>{h.counting.slice(0,3).map(c => <a href={c.href}><strong>{c.name}</strong><ReportingStatus progress={c.progress!}/></a>)}</div></CardCollection></>}</div>}
        <p class="insight-footnote">Council cards compare municipal PR votes; ward cards compare ward votes. A vote lead does not establish a council majority. Missing ward progress is excluded.</p>
      </section>

      <ChaosPromo/>
      <section id="majority-maths" class="insight-section" aria-labelledby="majority-maths-title">
        <div class="insight-section-heading"><div><h2 id="majority-maths-title">Paths to a majority</h2><p>How far the largest parties are from more than half of the seats. Reported allocations only.</p></div><a class="insight-text-link" href="/chaos">Play Coalition Chaos →</a></div>
        <div class="insight-two-up">
          <article class="insight-panel insight-maths"><h3>Closest to a majority</h3><p class="insight-caption">Hung councils, ranked by the largest party’s seat shortfall.</p>
            <ol class="insight-seat-list">{h.nearMajorities.slice(0,6).map(r => <li><a href={r.council.builderHref}><div class="insight-seat-heading"><span><strong>{r.council.name}</strong><small>{partyStyle(r.party.name)[0]} · {r.party.count} of {r.council.seats!.total} seats</small></span><span class="insight-seat-gap"><strong>{r.short}</strong><small>{r.short===1?'seat':'seats'} short</small></span></div><div class="insight-threshold-chart" role="img" aria-label={`${r.party.count} seats; ${r.council.seats!.majority} needed for a majority`}><span style={`width:${r.party.count/r.council.seats!.total*100}%;background:${partyStyle(r.party.name)[1]}`}/><i style={`left:${r.council.seats!.majority/r.council.seats!.total*100}%`}/></div><span class="insight-seat-caption">{r.council.seats!.majority} needed <b>Try a combination ↗</b></span></a></li>)}</ol>
            {!h.nearMajorities.length && <p class="insight-empty">No reported hung councils with a single largest party yet.</p>}
          </article>
          <DividedCouncils councils={h.fragmentedCouncils}/>
        </div><p class="insight-footnote">Seat arithmetic does not imply coalition agreements. The closest list requires one largest party; the most divided list includes ties and ranks by seat share so council size does not dominate. Independent seats count towards the council total but are not treated as one party.</p>
      </section>

      <section id="government-changes" class="insight-section" aria-labelledby="government-changes-title">
        <div class="insight-section-heading"><div><h2 id="government-changes-title">Who governs</h2><p>Before & after the 2026 election</p></div><a href="/governments">All governments →</a></div>

        {h.governmentChanges.length > 0 && <CardCollection id="government-changes-cards" label="councils"><div class="insight-two-up" data-card-grid>{h.governmentChanges.map(c => <article class="insight-panel"><h3><a href={`${c.href}#government`}>{c.name}</a></h3><GovernmentNote context={c.government}/></article>)}</div></CardCollection>}
        <CardCollection id="government-partners-cards" label="councils"><div class="insight-two-up" data-card-grid>{h.recordedPartners.slice(0,6).map(({council:c,comparison}) => <article class="insight-panel"><h3><a href={`${c.href}#government`}>{c.name}</a></h3><GovernmentNote context={c.government}/><p><strong>{comparison.total} of {comparison.councilSize} seats</strong> · {comparison.majority} needed</p><p class="insight-caption">{comparison.shortfall ? `${comparison.shortfall} short of a hypothetical majority` : 'Enough seats for a hypothetical majority'}. {comparison.basis === 'verified-before-election' ? 'Verified pre-election members' : 'Original members'} only; outside supporters excluded.</p></article>)}</div></CardCollection>
        {!h.recordedPartners.length && <p class="insight-caption">Partner comparisons will appear when complete reported seats and reliable party matches are available.</p>}
      </section>

      <section id="province-picture" class="insight-section" aria-labelledby="province-picture-title">
        <div class="insight-section-heading"><div><h2 id="province-picture-title">The picture by province</h2><p>How council outcomes are taking shape. Each bar represents all councils in a province.</p></div></div>
        <div class="insight-panel insight-provinces"><div class="insight-outcome-key">{outcomeKey.filter(s=>s.key!=='unavailable'||h.provinceOutcomes.some(p=>p.unavailable)).map(s=><span><i class={`insight-outcome--${s.key}`}/>{s.label}</span>)}</div>
          <ul>{h.provinceOutcomes.map(p=><li><a href={councilFilterUrl({province:p.id})}><span class="insight-province-name"><strong>{p.name}</strong><small>{p.reported}/{p.total} allocations reported</small></span><span class="insight-province-bar" role="img" aria-label={`${p.majority} majority, ${p.noMajority} hung councils, ${p.pending} pending, ${p.unavailable} unavailable`}>{outcomeKey.map(s=>p[s.key]>0&&<span class={`insight-outcome--${s.key}`} title={`${p[s.key]} ${s.label.toLowerCase()}`} style={`width:${p.total?p[s.key]/p.total*100:0}%`}>{p[s.key]/p.total >= .08 ? p[s.key] : null}</span>)}</span><span class="insight-province-arrow" aria-hidden="true">↗</span></a></li>)}</ul>
        </div>
      </section>
      <CivicGuide topic="outcomes"/>
      <details class="insight-methodology"><summary>Sources & methodology</summary><p>IEC results are provisional. “Reported” refers to the published seat allocation; completed district reporting is not an official declaration. Majorities describe seats, not governing agreements.</p><p>Comparisons match published municipal area IDs across elections, using complete party lists for combined ward and PR vote shares. Boundaries may differ. Missing comparisons and unfinished current counts are excluded from the swing rankings. “pp” means percentage points.</p><p>Seat changes compare ward + PR seats across the same councils with reported allocations in both elections. Parties are matched by ID; a party absent from a complete allocation has zero seats. Independent seats are combined as a group. Council sizes can change, so gains and losses need not balance.</p><p>{data.summaryCoverage}/{data.total} council summaries available. Local swings, close races and majority-threshold lists show up to six results each. The seat-change chart shows the eight largest net changes. All update as new results arrive.</p><div><a href="/">National vote shares & history →</a><a href="/updates">Latest announcements →</a><a href="/councils">Explore all councils →</a></div></details>
    </> : <section class="insight-panel insight-unavailable" role="status"><h2>Highlights are temporarily unavailable</h2><p>We couldn’t load the council summaries. Please try again shortly.</p><a class="button" href="/highlights">Try again</a><a class="insight-text-link" href="/councils">Browse councils →</a></section>}
  </div>
</Site>
