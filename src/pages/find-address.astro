---
import Site from '../layouts/Site.astro';
import PlaceSearch from '../components/PlaceSearch.astro';
import AddressResult from '../components/AddressResult.astro';
import '../styles/address.css';
Astro.response.headers.set('Cache-Control','no-store');
---
<Site title="Find results near your address" description="Find the electoral ward at a South African address or landmark, then explore its election results." mobileSearchHeader>
<nav class="breadcrumbs address-breadcrumbs" aria-label="Breadcrumb"><a href="/">South Africa</a><span>/</span><span>Find an address</span></nav>
<div class="page-top address-page-top"><div><h1>Find your ward</h1></div></div>
<section class="address-lookup" data-address-lookup>
  <div class="card address-search">
    <div class="address-search-header"><PlaceSearch id="ward-search" mode="address" presentation="header" compact/></div>
    <p class="small">Search for your address or a nearby landmark to find your ward. Google receives your search. Counted doesn’t save your address. <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
    <a class="address-directory" href="/search">Search by town or municipality →</a>
  </div>
  <AddressResult/>
  <noscript><p>Address search needs JavaScript. <a href="/search">Search our area directory instead.</a></p></noscript>
</section>
</Site>
