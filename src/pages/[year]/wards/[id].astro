---
import CardCollection from '../../../components/CardCollection.astro';
import ChaosPromo from '../../../components/ChaosPromo.astro';
import Icon from '../../../components/Icon.astro';
import PageShare from '../../../components/PageShare.astro';
import WardAddress from '../../../components/WardAddress.astro';
import CivicGuide from '../../../components/CivicGuide.astro';
import AreaHeader from '../../../components/AreaHeader.astro';
import ElectionResults from '../../../components/ElectionResults.astro';
import ResultStory from '../../../components/ResultStory.astro';
import ResultDetails from '../../../components/ResultDetails.astro';
import VoteHistory from '../../../components/VoteHistory.astro';
import GovernmentNote from '../../../components/GovernmentNote.astro';
import { provinces,provinceUrl } from '../../../lib/overview/results.ts';
import { electionYear, latestYear, nationalUrl } from '../../../lib/history/comparison.ts';
import { env } from 'cloudflare:workers';
import { mapLink } from '../../../lib/maps/config.ts';
import { findMapWard } from '../../../lib/maps/ward-catalogue.ts';
import RegionMap from '../../../components/RegionMap.astro';
import RelatedPlaces from '../../../components/RelatedPlaces.astro';
import { joinedResults } from '../../../lib/data/packed-results.ts';
import Site from '../../../layouts/Site.astro';
import ResultChart from '../../../components/ResultChart.astro';
import { places, placeUrl, wardNumber } from '../../../lib/places/catalogue.ts';
import { getWardResults, type Result } from '../../../lib/places/results.ts';
const year = electionYear(Astro.params.year);
if (!year) return new Response('Election not found', {status:404});
const id = Astro.params.id ?? '';
const boundary = findMapWard(id);
let result: Result | null = null; let failed = false;
if (/^\d{8}$/.test(id)) { try { result = await getWardResults(env.RESULTS_DB,id, env.RAW_RESULTS,year); } catch(e) { console.error('Ward unavailable',e); failed = true; } }
const parent = result ? places.find(p => p.relationships.some(r => r.election === 2026 && r.level === 'municipality' && r.relation === 'equals' && r.areaId === result!.municipalityId)) : null;
const municipalityName = parent?.name ?? boundary?.municipality ?? result?.municipalityId ?? '';
const province = provinces.find(p=>p.name===(parent?.province ?? boundary?.province));
Astro.response.status = failed ? 503 : result ? 200 : 404;
Astro.response.headers.set('Cache-Control', result ? 'public, max-age=15, s-maxage=15' : 'no-store');
if(failed) Astro.response.headers.set('Retry-After','60');
let districts:{area_id:string;name:string}[]=[];
if(result)try{districts=(await env.RESULTS_DB.prepare(`SELECT r.area_id,r.name ${joinedResults} WHERE r.year=? AND r.level='voting-district' AND r.ward_id=? ORDER BY r.name`) .bind(year,id).all<{area_id:string;name:string}>()).results;}catch{}
const title = result ? `Ward ${wardNumber(id)}, ${municipalityName}` : 'Ward results unavailable';
---
<Site liveResults={year === latestYear && Astro.response.status !== 404} title={`${title} — ${year} results`} description={`Published ward-ballot votes, reporting progress and sources for ${title}.`} noindex={!result || !parent}>
{result ? <>
<AreaHeader name={`Ward ${wardNumber(id)}`} scope={municipalityName} year={year} level="ward" areaId={id} parents={[{name:'South Africa',href:nationalUrl(year)},...(province?[{name:province.name,href:provinceUrl(province,year)}]:[]),...(parent?[{name:municipalityName,href:placeUrl(parent,year)}]:[])]}/>
<WardAddress id={id}/>
<ResultStory result={result}/>
<ElectionResults year={year} level="ward" areaId={id}><ResultChart result={result} ballot="ward" tabs={false} name={title} compact/></ElectionResults>
<VoteHistory result={result}/>
<CivicGuide topic="ward"/>
<section><div class="explore-section-heading"><h2>Go closer</h2><span class="small">{districts.length} voting districts</span></div><CardCollection id="explore-cards-1" label="voting districts"><nav class="explore-grid" data-card-grid aria-label="Voting districts">{districts.map(d=><a href={`/${year}/voting-districts/${d.area_id}`}><span>Voting district</span><strong>{d.name.replace(/^\d+\s*-\s*/,"")}</strong><Icon name="arrowRight" size={18}/></a>)}</nav></CardCollection><CivicGuide topic="voting-district"/></section>
{year===latestYear&&boundary&&<RegionMap historical={year !== latestYear} options={{level:"ward",id,bbox:boundary.bbox}} title={`Ward ${wardNumber(id)} and its voting districts`} href={mapLink(parent?.slug??"south-africa",id)}/>}
{parent&&<CardCollection id="explore-cards-2" label="places"><nav class="explore-grid" data-card-grid aria-label="Explore wider"><a href={placeUrl(parent,year)}><span>Municipality</span><strong>{municipalityName}</strong><b aria-hidden="true">↑</b></a><a href={placeUrl(parent,year)+'#wards'}><span>Nearby</span><strong>All wards in {municipalityName}</strong><Icon name="arrowRight" size={18}/></a></nav></CardCollection>}
<GovernmentNote municipalityId={result.municipalityId} year={year} name={municipalityName}/>
{year === latestYear && parent && <ChaosPromo name={municipalityName} href={`${placeUrl(parent)}/coalition`}/>}
{year === latestYear && <RelatedPlaces scope={{wardId: id}} directory={{ward: id}} name={title} ward/>}
<ResultDetails result={result}/>
</> : <section class="empty"><div class="page-share-heading"><h1>{failed ? 'Results are temporarily unavailable.' : 'Ward results unavailable.'}</h1><PageShare/></div><p>{failed ? 'Please try again shortly.' : 'Select another ward on the map to see its published results.'}</p><a href="/map">Explore the map <Icon name="arrowRight" size={14}/></a></section>}
</Site>

<style>
  .ward-context{grid-template-columns:minmax(0,1fr)}
</style>
