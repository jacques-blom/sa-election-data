---
import PageShare from '../../../components/PageShare.astro';
import ElectionHistory from '../../../components/ElectionHistory.astro';
import { electionYear, latestYear, nationalUrl } from '../../../lib/history/comparison.ts';
import { env } from 'cloudflare:workers';
import { mapLink } from '../../../lib/maps/config.ts';
import { findMapWard } from '../../../lib/maps/ward-catalogue.ts';
import RegionMap from '../../../components/RegionMap.astro';
import RelatedPlaces from '../../../components/RelatedPlaces.astro';
import { joinedResults } from '../../../lib/data/packed-results.ts';
import Site from '../../../layouts/Site.astro';
import MajorityBanner from '../../../components/MajorityBanner.astro';
import ResultChart from '../../../components/ResultChart.astro';
import { places, placeUrl, wardNumber } from '../../../lib/places/catalogue.ts';
import { getWardResults, type Result } from '../../../lib/places/results.ts';
const year = electionYear(Astro.params.year);
if (!year) return new Response('Election not found', {status:404});
const id = Astro.params.id ?? '';
const boundary = findMapWard(id);
let result: Result | null = null; let failed = false;
if (/^\d{8}$/.test(id)) { try { result = await getWardResults(env.RESULTS_DB,id, env.RAW_RESULTS,year); } catch(e) { console.error('Ward unavailable',e); failed = true; } }
const parent = result ? places.find(p => p.relationships.some(r => r.election === 2026 && r.level === 'municipality' && r.relation === 'equals' && r.areaId === result!.municipalityId)) : null;
const municipalityName = parent?.name ?? boundary?.municipality ?? result?.municipalityId ?? '';
const province = parent?.province ?? boundary?.province;
Astro.response.status = failed ? 503 : result ? 200 : 404;
Astro.response.headers.set('Cache-Control', result ? 'public, max-age=15, s-maxage=15' : 'no-store');
if(failed) Astro.response.headers.set('Retry-After','60');
let districts:{area_id:string;name:string}[]=[];
if(result)try{districts=(await env.RESULTS_DB.prepare(`SELECT r.area_id,r.name ${joinedResults} WHERE r.year=? AND r.level='voting-district' AND r.ward_id=? ORDER BY r.name`) .bind(year,id).all<{area_id:string;name:string}>()).results;}catch{}
const title = result ? `Ward ${wardNumber(id)}, ${municipalityName}` : 'Ward results unavailable';
---
<Site liveResults={year === latestYear && Astro.response.status !== 404} title={`${title} — ${year} results`} description={`Published ward-ballot votes, reporting progress and sources for ${title}.`} noindex={!result || !parent}>
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href={nationalUrl(year)}>South Africa</a>{parent ? <><span> / </span><a href={placeUrl(parent,year)}>{municipalityName}</a></> : municipalityName && <><span> / </span><span>{municipalityName}</span></>}<span> / </span><span>{result ? `Ward ${wardNumber(id)}` : 'Ward'}</span></nav>
{result ? <>
<div class="page-top page-share-heading"><div><p class="eyebrow">{province} · {municipalityName} · {year}</p><h1>Ward {wardNumber(id)}</h1></div><PageShare result/></div>
<div id="ward-majority" data-history-current-only hidden={year !== latestYear}>{year === latestYear && parent && <MajorityBanner name={parent.name} href={`${placeUrl(parent)}/coalition`}/>}</div>
<div id="ward-results" class="results-layout"><ResultChart result={result} ballot="ward" tabs={false} name={title}/><aside class="aside-stack ward-context"><section class="card scope-card">
{parent ? <><h2>Municipality results</h2><a class="button" href={placeUrl(parent,year)}>View {municipalityName} results ↗</a></> : <><h2>Explore nearby wards</h2><a class="button" href={mapLink('south-africa',id)}>Return to the map ↗</a></>}
</section><ElectionHistory year={year} level="ward" id={id}/></aside></div>
<section style="margin-top:28px"><h2>Voting districts in this ward</h2><div class="links">{districts.map(d=><a href={`/${year}/voting-districts/${d.area_id}`}>{d.name.replace(/^\d+\s*-\s*/,"")} ↗</a>)}</div></section>
{boundary&&<RegionMap historical={year !== latestYear} options={{level:"ward",id,bbox:boundary.bbox}} title={`Ward ${wardNumber(id)} and its voting districts`} href={mapLink(parent?.slug??"south-africa",id)} caption="Voting district boundaries"/>}
<div class="links"><a href={parent ? placeUrl(parent,year)+'#wards' : mapLink('south-africa',id)}>Browse other wards</a></div>
{year === latestYear && <RelatedPlaces scope={{wardId: id}} directory={{ward: id}} name={title} ward/>}
</> : <section class="empty"><div class="page-share-heading"><h1>{failed ? 'Results are temporarily unavailable.' : 'Ward results unavailable.'}</h1><PageShare/></div><p>{failed ? 'Please try again shortly.' : 'Select another ward on the map to see its published results.'}</p><a href="/map">Explore the map →</a></section>}
</Site>

<style>
  .ward-context{grid-template-columns:minmax(0,1fr)}
</style>
