---
import CardCollection from '../../../components/CardCollection.astro';
import ChaosPromo from '../../../components/ChaosPromo.astro';
import Icon from '../../../components/Icon.astro';
import PageShare from '../../../components/PageShare.astro';
import CivicGuide from '../../../components/CivicGuide.astro';
import AreaHeader from '../../../components/AreaHeader.astro';
import ElectionResults from '../../../components/ElectionResults.astro';
import ResultStory from '../../../components/ResultStory.astro';
import ResultDetails from '../../../components/ResultDetails.astro';
import VoteHistory from '../../../components/VoteHistory.astro';
import GovernmentNote from '../../../components/GovernmentNote.astro';
import { places } from '../../../lib/places/catalogue.ts';
import { provinces,provinceUrl } from '../../../lib/overview/results.ts';
import { electionYear, latestYear, nationalUrl } from '../../../lib/history/comparison.ts';
import { env } from 'cloudflare:workers';
import Site from '../../../layouts/Site.astro';
import RegionMap from '../../../components/RegionMap.astro';
import ResultChart from '../../../components/ResultChart.astro';
import { getVotingDistrictResults,type Result } from '../../../lib/places/results.ts';
import { joinedResults } from '../../../lib/data/packed-results.ts';
import { administrative } from '../../../lib/maps/administrative.ts';
import { wardNumber } from '../../../lib/places/catalogue.ts';
import { mapLink } from '../../../lib/maps/config.ts';
const year = electionYear(Astro.params.year);
if (!year) return new Response('Election not found', {status:404});
type DistrictBoundary={ward_id:string;minx:number;miny:number;maxx:number;maxy:number};
const id=Astro.params.id??'';let result:Result|null=null;let boundary:DistrictBoundary|null=null;let failed=false;let wardId:string|null=null;
if(/^\d{8,10}$/.test(id))try{
 const [district,area,geometry]=await Promise.all([
  getVotingDistrictResults(env.RESULTS_DB,id,env.RAW_RESULTS,year),
  env.RESULTS_DB.prepare(`SELECT r.ward_id ${joinedResults} WHERE r.year=? AND r.level='voting-district' AND r.area_id=?`) .bind(year,id).first<{ward_id:string}>(),
  (env.GEOGRAPHY_DB??env.RESULTS_DB).prepare("SELECT minx,miny,maxx,maxy FROM map_geometries WHERE level='voting-district' AND id=?") .bind(id).first<Omit<DistrictBoundary,'ward_id'>>(),
 ]);
 result=district;wardId=area?.ward_id??null;
 boundary=area&&geometry?{...area,...geometry}:null;
}catch{failed=true;}
Astro.response.status=failed?503:result?200:404;
Astro.response.headers.set('Cache-Control',result?'public, max-age=15, s-maxage=15':'no-store');
const parent=result?.municipalityId?administrative.municipalities[result.municipalityId]:null;
const municipality=places.find(p=>p.relationships.some(r=>r.level==='municipality'&&r.relation==='equals'&&r.areaId===result?.municipalityId));
const province=provinces.find(p=>p.name===municipality?.province);
const title=result?.name.replace(/^\d+\s*-\s*/,'')??'Voting district unavailable';
const ballot=Astro.url.searchParams.get('ballot')==='ward'?'ward':'pr';
---
<Site liveResults={year === latestYear && Astro.response.status !== 404} title={`${title} — ${year} election results`} description={`Election results for voting district ${id}, with party vote shares and reporting progress.`} noindex>
{result?<>
<AreaHeader name={title} scope={`Voting district · ${id}`} year={year} level="voting-district" areaId={id} parents={[{name:'South Africa',href:nationalUrl(year)},...(province?[{name:province.name,href:provinceUrl(province,year)}]:[]),...(parent?[{name:parent.name,href:parent.url.replace('/2026/',`/${year}/`)}]:[]),...(wardId?[{name:`Ward ${wardNumber(wardId)}`,href:`/${year}/wards/${wardId}`}]:[])]}/>
<ResultStory result={result}/>
<ElectionResults year={year} level="voting-district" areaId={id}><ResultChart result={result} ballot={ballot} name={title} compact/></ElectionResults>
<VoteHistory result={result}/>
<CivicGuide topic="voting-district"/>
{year === latestYear && parent && <ChaosPromo name={parent.name} href={`${parent.url}/coalition`}/>}
<div class="explore-section-heading"><h2>Go wider</h2></div><CardCollection id="explore-cards-1" label="places"><nav class="explore-grid" data-card-grid aria-label="Explore wider">{wardId&&<a href={`/${year}/wards/${wardId}`}><span>Ward</span><strong>Ward {wardNumber(wardId)}</strong><b aria-hidden="true">↑</b></a>}{parent&&<a href={parent.url.replace('/2026/',`/${year}/`)}><span>Municipality</span><strong>{parent.name}</strong><b aria-hidden="true">↑</b></a>}</nav></CardCollection>
<GovernmentNote municipalityId={result.municipalityId} year={year} name={parent?.name??municipality?.name}/>
{year===latestYear&&boundary&&<RegionMap historical={year !== latestYear} options={{level:'voting-district',id,bbox:[boundary.minx,boundary.miny,boundary.maxx,boundary.maxy]}} title={title} href={mapLink(parent?.slug??'south-africa',boundary.ward_id)}/>}
<ResultDetails result={result}/>
</>:<section class="empty"><div class="page-share-heading"><h1>{title}</h1><PageShare/></div><p>{failed?'Please try again shortly.':'Try another district or browse the map.'}</p><a href="/map">Explore map <Icon name="arrowRight" size={14}/></a></section>}
</Site>
