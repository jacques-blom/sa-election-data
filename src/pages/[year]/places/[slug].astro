---
import PageShare from '../../../components/PageShare.astro';
import ElectionHistory from '../../../components/ElectionHistory.astro';
import RelatedNews from '../../../components/RelatedNews.astro';
import { electionYear, latestYear, nationalUrl } from '../../../lib/history/comparison.ts';
import { env } from 'cloudflare:workers';
import { mapLink } from '../../../lib/maps/config.ts';
import { administrative } from '../../../lib/maps/administrative.ts';
import Site from '../../../layouts/Site.astro';
import RegionMap from '../../../components/RegionMap.astro';
import ResultChart from '../../../components/ResultChart.astro';
import PlaceSearch from '../../../components/PlaceSearch.astro';
import AddressResult from '../../../components/AddressResult.astro';
import Wards from '../../../components/Wards.astro';
import RelatedPlaces from '../../../components/RelatedPlaces.astro';
import { districts, districtUrl } from '../../../lib/maps/districts.ts';
import { placeDirectoryUrl } from '../../../lib/places/browse.ts';
import CouncilSeats from '../../../components/CouncilSeats.astro';
import MajorityBanner from '../../../components/MajorityBanner.astro';
import '../../../styles/municipality.css';
import { placeUrl, places } from '../../../lib/places/catalogue.ts';
import { findDirectoryPlace } from '../../../lib/places/directory.ts';
import { getPlaceResults,type PlaceResults } from '../../../lib/places/results.ts';
import { provinces,provinceUrl } from '../../../lib/overview/results.ts';
const year = electionYear(Astro.params.year);
if (!year) return new Response('Election not found', {status:404});
let place:Awaited<ReturnType<typeof findDirectoryPlace>>;let data:PlaceResults|null=null;let failed=false;
try{place=await findDirectoryPlace(env.GEOGRAPHY_DB??env.RESULTS_DB,Astro.params.slug??'');if(place && !(year !== latestYear && ['town','suburb'].includes(place.kind)))data=await getPlaceResults(env.RESULTS_DB,place,env.RAW_RESULTS,year);}catch{failed=true;}
Astro.response.status=failed?503:!place?404:!data?.municipality?(year === latestYear ? 503 : 404):200;
Astro.response.headers.set('Cache-Control',Astro.response.status===200?'public, max-age=15, s-maxage=15':'no-store');
if(Astro.response.status===503)Astro.response.headers.set('Retry-After','60');
const ballot=Astro.url.searchParams.get('ballot')==='ward'?'ward':'pr';
const parentIds=place?.relationships.filter(r=>r.level==='municipality'&&r.election===2026).map(r=>r.areaId)??[];
const parents=places.filter(p=>p.relationships.some(r=>r.level==='municipality'&&r.relation==='equals'&&parentIds.includes(r.areaId)));
const town=place?.kind==='town'||place?.kind==='suburb';
const province=provinces.find(p=>p.name===place?.province);
const district=year === latestYear && !town ? districts.find(d => d.municipalitySlugs.includes(place?.slug ?? '')) : undefined;
const boundary=place?.geometry;
const hasMap=!!place?.bbox && !!boundary;
---
<Site liveResults={year === latestYear && Astro.response.status !== 404} title={place?`${place.name} election results ${year}`:'Area not found'} description={place?.description??'Find local election results by place name.'} noindex={!place?.indexable||Astro.response.status!==200}>
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href={nationalUrl(year)}>South Africa</a>{province&&<><span>/</span><a href={provinceUrl(province,year)}>{province.name}</a></>}{district&&<><span>/</span><a href={districtUrl(district)}>{district.name}</a></>}{town&&parents.length===1&&<><span>/</span><a href={placeUrl(parents[0]!,year)}>{parents[0]!.name}</a></>}{place&&<><span>/</span><span aria-current="page">{place.name}</span></>}</nav>
{place?<>
<div class="page-top page-share-heading"><div><p class="eyebrow">{place.province} · {place.kind==='metro'?'Metropolitan municipality':place.kind} · {year}</p><h1>{place.name}</h1></div><PageShare result/></div>

{town && year === latestYear && parents.length > 0 && <section class="town-municipalities" aria-labelledby="town-municipalities-heading">
  <h2 id="town-municipalities-heading">Municipality results</h2>
  <div class="town-municipality-grid">{parents.map(parent => <a class="town-municipality-card" href={placeUrl(parent,year)}>
    <div><p class="eyebrow">{parent.kind === 'metro' ? 'Metropolitan municipality' : 'Local municipality'}</p><h3>{parent.name}</h3><p>Full council results, seats and wards.</p></div>
    <span class="town-municipality-action">View results <span aria-hidden="true">→</span></span>
  </a>)}</div>
</section>}
{town&&<p class="notice">Whole-ward results include areas outside {place.name}.</p>}
{data?.municipality?<>
<div id="municipality-seats">{!town&&<CouncilSeats result={data.municipality} href={placeUrl(place,year)} name={place.name}/>}</div>
{!town?<div id="municipality-results" class="results-layout municipality-results">
  <ResultChart result={data.municipality} ballot={ballot} name={place.name}/>
  <aside class="municipality-tools" aria-label="Map and address lookup">
    {hasMap&&place.bbox&&boundary&&<RegionMap compact historical={year !== latestYear} options={{bbox:place.bbox,level:boundary.level,id:boundary.id,code:administrative.municipalities[boundary.id]?.code}} title={`${place.name} and its wards`} href={mapLink(place.slug)} caption="Ward boundaries"><ElectionHistory slot="history" year={year} level="municipality" id={parentIds[0] ?? ''} embedded/></RegionMap>}
    {!hasMap && <ElectionHistory year={year} level="municipality" id={parentIds[0] ?? ''}/>}
    <section id="find-your-ward" class="card municipality-ward-finder" data-address-lookup aria-labelledby="ward-address-heading">
      <h2 id="ward-address-heading">Find your ward by address</h2>
      <PlaceSearch id="municipality-address" mode="address" action="/search" compact area={place.bbox ? {name:place.name,bbox:place.bbox} : undefined}/>
      <AddressResult/>
      <div class="links"><a href="#wards">Browse all {data.wards.length} wards ↓</a></div>
      <noscript><p class="small">Address search needs JavaScript. Browse the wards below or <a href="/search">search by area name</a>.</p></noscript>
    </section>
  </aside>
</div>:null}
{!town && year === latestYear && <RelatedNews scope="municipality" area={place.slug}/>}
<Wards preview={town} searchable={town} wards={data.wards} title={town?`Ward results around ${place.name}`:'Ward results'} note={town?'Whole-ward results':'Ward ballot'}/>
{town&&year === latestYear&&place.bbox&&boundary&&<RegionMap options={{bbox:place.bbox,level:boundary.level,id:boundary.id,wardIds:place.relationships.filter(r=>r.level==='ward').map(r=>r.areaId)}} title={`${place.name} and its wards`} href={mapLink(place.slug)} caption="Dashed: statistical place boundary · Shaded: overlapping wards"><ElectionHistory slot="history" year={year} level="municipality" id={parentIds[0] ?? ''} currentOnly embedded/></RegionMap>}
{town&&!hasMap&&<ElectionHistory year={year} level="municipality" id={parentIds[0] ?? ''} currentOnly/>}
{town&&<section class="card scope-card"><div class="card-heading"><h2>Which results cover {place.name}?</h2></div>{place.boundaryContext?.notes.map(note=><p>{note}</p>)}<div class="links">{parents.map(parent=><a href={placeUrl(parent,year)}>Whole {parent.name} council result ↗</a>)}<a href="/search">Find the ward at your address →</a></div><details><summary>How we matched this place to wards</summary><p>{place.boundaryContext?.method}</p><ul>{place.sources.map(s=><li><a href={s.url}>{s.label} ↗</a></li>)}</ul></details></section>}
{data.missingWardIds.length>0&&<p class="notice">Results are not available for mapped wards: {data.missingWardIds.join(', ')}.</p>}

</>:<><ElectionHistory year={year} level="municipality" id={parentIds[0] ?? ''} currentOnly={town}/><section class="empty"><h2>{year === latestYear ? town ? 'Results are temporarily unavailable.' : 'Council seats pending' : 'Historical results unavailable.'}</h2><p>{year === latestYear ? 'Please try again shortly.' : 'This area has no mapped result for this election. Select another year above.'}</p><a href={place.sources[0]?.url}>View the source →</a></section>{!town&&year===latestYear&&<MajorityBanner name={place.name} href={`${placeUrl(place)}/coalition`}/>}</>}
{!data?.municipality && !town && year === latestYear && <RelatedNews scope="municipality" area={place.slug}/>}
{year === latestYear && !town && parentIds[0] && <RelatedPlaces scope={{municipalityId: parentIds[0]}} directory={{municipality: place.slug}} name={place.name}/>}
{year === latestYear && town && <nav class="links" aria-label="Explore related places">{parents.map(parent => <a href={placeDirectoryUrl({municipality: parent.slug})}>More places around {parent.name} →</a>)}{province && <a href={placeDirectoryUrl({province: province.slug})}>All places in {province.name} →</a>}</nav>}
</>:<section class="empty"><div class="page-share-heading"><h1>{failed?'Results are temporarily unavailable.':'Area not found.'}</h1><PageShare/></div><a href="/search">Find your area →</a></section>}
</Site>
