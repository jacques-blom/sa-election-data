---
import CardCollection from '../../../components/CardCollection.astro';
import Icon from '../../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import Site from '../../../layouts/Site.astro';
import AreaHeader from '../../../components/AreaHeader.astro';
import ElectionResults from '../../../components/ElectionResults.astro';
import ResultStory from '../../../components/ResultStory.astro';
import ResultDetails from '../../../components/ResultDetails.astro';
import VoteHistory from '../../../components/VoteHistory.astro';
import ResultChart from '../../../components/ResultChart.astro';
import CouncilSeats from '../../../components/CouncilSeats.astro';
import { electionCouncilSeats } from '../../../lib/history/seats.ts';
import CouncilGovernment from '../../../components/CouncilGovernment.astro';
import CivicGuide from '../../../components/CivicGuide.astro';
import Wards from '../../../components/Wards.astro';
import PlaceSearch from '../../../components/PlaceSearch.astro';
import AddressResult from '../../../components/AddressResult.astro';
import RegionMap from '../../../components/RegionMap.astro';
import RelatedPlaces from '../../../components/RelatedPlaces.astro';
import RelatedNews from '../../../components/RelatedNews.astro';
import { electionYear,latestYear,nationalUrl } from '../../../lib/history/comparison.ts';
import { findDirectoryPlace } from '../../../lib/places/directory.ts';
import { getPlaceResults,type PlaceResults } from '../../../lib/places/results.ts';
import { placeCouncilParents } from '../../../lib/places/hierarchy.ts';
import { placeUrl } from '../../../lib/places/catalogue.ts';
import { provinces,provinceUrl } from '../../../lib/overview/results.ts';
import { mapLink } from '../../../lib/maps/config.ts';
import { districtUrl } from '../../../lib/maps/districts.ts';
import '../../../styles/municipality.css';
const year=electionYear(Astro.params.year);
if(!year)return new Response('Election not found',{status:404});
let place:Awaited<ReturnType<typeof findDirectoryPlace>>,data:PlaceResults|null=null,failed=false;
try{place=await findDirectoryPlace(env.GEOGRAPHY_DB??env.RESULTS_DB,Astro.params.slug??'');}catch{failed=true;}
const town=place?.kind==='town'||place?.kind==='suburb';
// The place remains a familiar entry point; historical results belong to its named council.
// Historical ward lists use the selected election's council, never today's town intersections.
const parents=place?placeCouncilParents(place):[];
const selected=parents.find(p=>p.municipality.relationships.some(r=>r.level==='municipality'&&r.areaId===Astro.url.searchParams.get('council')))??parents[0];
const council=town?selected?.municipality:place;
const councilId=council?.relationships.find(r=>r.level==='municipality'&&r.relation==='equals')?.areaId??'';
try{if(place)data=await getPlaceResults(env.RESULTS_DB,town&&year!==latestYear&&council?council:place,env.RAW_RESULTS,year);}catch{failed=true;}
const result=data?.municipalities.find(m=>m.id===councilId)??data?.municipality;
const hasCouncilSeats=result&&electionCouncilSeats(result).status!=='unavailable';
const wards=data?.wards.filter(w=>!councilId||w.municipalityId===councilId)??[];
const province=provinces.find(p=>p.name===place?.province);
const district=year===latestYear?selected?.district:undefined;
const ballot=Astro.url.searchParams.get('ballot')==='ward'?'ward':'pr';
const mapPlace=town&&year!==latestYear?council:place;
const mapBoundary=mapPlace?.geometry;
Astro.response.status=failed?503:!place?404:!result?(year===latestYear?503:404):200;
Astro.response.headers.set('Cache-Control',Astro.response.status===200?'public, max-age=15, s-maxage=15':'no-store');
if(Astro.response.status===503)Astro.response.headers.set('Retry-After','60');
const crumbs=[{name:'South Africa',href:nationalUrl(year)},...(province?[{name:province.name,href:provinceUrl(province,year)}]:[]),...(town&&council?[{name:council.name,href:placeUrl(council,year)}]:[])];
---
<Site liveResults={year===latestYear&&Astro.response.status!==404} title={place?`${place.name} election results ${year}`:'Area not found'} description={place?`See what changed in ${place.name}, explore its council and wards, and compare previous elections.`:'Find local election results.'} noindex={!place?.indexable||Astro.response.status!==200}>
{place?<>
  <AreaHeader name={place.name} scope={town?`Your municipality · ${council?.name??place.municipalityName}`:place.kind==='metro'?'Metropolitan council':'Municipal council'} year={year} level="municipality" areaId={councilId} parents={crumbs}/>
  {town&&parents.length>1&&<nav class="area-councils" aria-label="Councils covering this place">{parents.map(p=>{const id=p.municipality.relationships.find(r=>r.level==='municipality'&&r.relation==='equals')?.areaId;return <a data-explore-link href={`?council=${id}`} aria-current={id===councilId?'page':undefined}>{p.municipality.name}</a>;})}</nav>}
  {result?<>
    <ResultStory result={result} compact/>
    <ElectionResults year={year} level="municipality" areaId={councilId}>
      <CouncilSeats result={result} href={placeUrl(council??place,year)} name={council?.name??place.name}/>
      <details id="vote-results" class="result-breakdown vote-breakdown" open={!hasCouncilSeats||Astro.url.searchParams.has('ballot')}><summary><span class="detail-icon"><Icon name="vote" size={16}/></span><span>Vote breakdown</span><Icon name="plus" class="detail-plus"/></summary><div class="breakdown-content">
        <ResultChart result={result} ballot={ballot} name={council?.name??place.name} compact/>
      </div></details>
    </ElectionResults>
    <VoteHistory result={result}/>
    {[2021,latestYear].includes(year)&&<CouncilGovernment municipalityId={result.id} result={result}/>}
    <div class="explore-section-heading"><h2>Go closer</h2><a href={year===latestYear?"#find-your-ward":"#wards"}>{year===latestYear?"Find my ward":"Browse wards"} <Icon name="arrowDownRight" size={16}/></a></div>

    <section class="explore-map-layout">
      {year===latestYear&&<section id="find-your-ward" class="card explore-address" data-address-lookup><h2><Icon name="locate" size={20}/>Find your ward</h2><PlaceSearch id="municipality-address" mode="address" action="/search" compact area={place.bbox?{name:place.name,bbox:place.bbox}:undefined}/><AddressResult/></section>}
      {year===latestYear&&mapPlace?.bbox&&mapBoundary&&<RegionMap historical={year!==latestYear} options={{bbox:mapPlace.bbox,level:mapBoundary.level,id:mapBoundary.id,...(town&&year===latestYear?{wardIds:wards.map(w=>w.id)}:{})}} title={`${mapPlace.name} and its wards`} href={mapLink(mapPlace.slug)}/>}

    </section>
    <Wards wards={wards} title={town&&year===latestYear?`Wards covering ${place.name}`:`Wards in ${council?.name??place.name}`} note=""/>
    <CivicGuide topic="government"/>
    {district&&<CardCollection id="explore-cards-1" label="places"><nav class="explore-grid" data-card-grid aria-label="District council"><a href={districtUrl(district)}><span>District council</span><strong>{district.name}</strong><Icon name="arrowRight" size={18}/></a></nav></CardCollection>}
    {year===latestYear&&<RelatedPlaces scope={{municipalityId:result.id}} directory={{municipality:council?.slug??place.slug}} name={council?.name??place.name}/>}
    {year===latestYear&&<details class="result-breakdown"><summary><span class="detail-icon"><Icon name="news" size={16}/></span><span>Local news</span><Icon name="plus" class="detail-plus"/></summary><RelatedNews scope="municipality" area={council?.slug??place.slug}/></details>}
    <ResultDetails result={result}>
      {town&&<><p>The council results cover all of {council?.name}. Ward results include areas outside {place.name}.</p>{place.boundaryContext?.notes.map(note=><p>{note}</p>)}{year!==latestYear&&<p>Town-to-ward mappings are available for 2026 only. The historical wards above belong to the whole municipality in {year}.</p>}<p>{place.boundaryContext?.method}</p><div class="links">{place.sources.map(s=><a href={s.url}>{s.label} <Icon name="arrowUpRight" size={13}/></a>)}</div></>}
      {(data?.missingWardIds.length ?? 0)>0&&<p>Unavailable ward results: {data?.missingWardIds.join(', ')}.</p>}
    </ResultDetails>
  </>:<ElectionResults year={year} level="municipality" areaId={councilId}><section class="empty"><h2>{year===latestYear?'Results unavailable':'No result for this election'}</h2><a href="/search">Find another place <Icon name="arrowRight" size={14}/></a></section></ElectionResults>}
</>:<section class="empty"><h1>{failed?'Results unavailable':'Area not found'}</h1><a href="/search">Find your area <Icon name="arrowRight" size={14}/></a></section>}
</Site>
