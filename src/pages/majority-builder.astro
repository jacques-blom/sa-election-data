---
// Keep existing links working while using one council directory on the councils page.
const params = new URLSearchParams();
for (const key of ['q', 'province']) {
  const value = Astro.url.searchParams.get(key);
  if (value) params.set(key, value);
}
if (Astro.url.searchParams.get('status') === 'pending') params.set('status', 'pending');
return Astro.redirect('/councils' + (params.size ? `?${params}` : '') + '#councils', 302);
