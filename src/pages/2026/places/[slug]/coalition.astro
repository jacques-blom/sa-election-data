---
import CoalitionGame from '../../../../components/CoalitionGame.astro';
import CoalitionStory from '../../../../components/CoalitionStory.astro';
import GetInvolved from '../../../../components/GetInvolved.astro';
import CoalitionPicker from '../../../../components/CoalitionPicker.astro';
import Icon from '../../../../components/Icon.astro';
import CouncilGovernment from '../../../../components/CouncilGovernment.astro';
import { governmentContext, governmentCaption } from '../../../../lib/governance/index.ts';
import RelatedNews from '../../../../components/RelatedNews.astro';
import { env } from 'cloudflare:workers';
import Site from '../../../../layouts/Site.astro';
import SeatMethod from '../../../../components/SeatMethod.astro';
import ResultStatus from '../../../../components/ResultStatus.astro';
import { findDirectoryPlace } from '../../../../lib/places/directory.ts';
import { placeUrl } from '../../../../lib/places/catalogue.ts';
import type { Result } from '../../../../lib/places/results.ts';
import { getBuilderResult } from '../../../../lib/seats/directory.ts';
import { councilSeats, canBuildCoalition } from '../../../../lib/seats/allocation.ts';
import { coalitionData } from '../../../../lib/seats/coalition.ts';
import { progressOf, provinces } from '../../../../lib/overview/results.ts';
import { coalitionDataNotice } from '../../../../lib/seats/data-notice.ts';
import '../../../../styles/coalition.css';
let place: Awaited<ReturnType<typeof findDirectoryPlace>>;
let municipality: Result | null = null;
let failed = false;
try {
  place = await findDirectoryPlace(env.GEOGRAPHY_DB ?? env.RESULTS_DB, Astro.params.slug ?? '');
  if (place && ['metro', 'municipality'].includes(place.kind)) {
    const id = place.relationships.find(r => r.election === 2026 && r.level === 'municipality' && r.relation === 'equals')?.areaId;
    if (id) municipality = await getBuilderResult(env.RESULTS_DB, id, env.RAW_RESULTS);
  }
} catch { failed = true; }
const seats = municipality ? councilSeats(municipality.level, municipality.results) : null;
const model = seats && canBuildCoalition(seats) && municipality && place ? coalitionData(place.name, seats, municipality.source) : null;
const progress = municipality ? progressOf(municipality) : null;
if (model) {
  model.progress = progress;
  model.municipalityId = municipality?.id;
  model.province = place?.province;
}
const localSnapshot = import.meta.env.DEV && import.meta.env.COUNTED_LOCAL_SNAPSHOT === true;
const dataNotice = municipality ? coalitionDataNotice(municipality, localSnapshot) : null;
if (model && municipality) model.governmentContext = governmentCaption(governmentContext(municipality.id));
const validCouncil = !!place && ['metro', 'municipality'].includes(place.kind);
Astro.response.status = failed ? 503 : !validCouncil ? 404 : 200;
Astro.response.headers.set('Cache-Control', Astro.response.status === 200 ? 'public, max-age=15, s-maxage=15' : 'no-store');
if (Astro.response.status === 503) Astro.response.headers.set('Retry-After', '60');
const resultUrl = place ? placeUrl(place) : '/search';
const province = provinces.find(p => p.name === place?.province);
---
<Site title={`Coalition Chaos${place ? ` · ${place.name}` : ''}`} description="Fictional scenario · Satirical game. Build a majority with council seat data, then test your deal with invented political plot twists." noindex liveResults={validCouncil && !localSnapshot}>
  <Fragment slot="header"><nav class="chaos-home" aria-label="Game navigation"><p class="chaos-logo">Coalition <span>Chaos<span class="chaos-dot">.</span></span></p><a class="chaos-results-button" href={validCouncil ? resultUrl : '/'}><span>View election results</span><Icon name="arrowUpRight" size={16}/></a></nav></Fragment>
  <section class="coalition-screen" data-coalition={model ? JSON.stringify(model) : undefined}>
    <header class="chaos-intro">
      <div class="coalition-location">
        {province && <button type="button" class="coalition-province" data-coalition-picker-open="provinces" aria-haspopup="dialog" aria-controls="coalition-picker" aria-label={`Change province: ${province.name}`}>{province.name}<Icon name="chevronDown" size={12}/></button>}
        <h1><button type="button" data-coalition-picker-open="councils" aria-haspopup="dialog" aria-controls="coalition-picker" aria-label={`Change council: ${place?.name ?? 'choose a municipality'}`}><span class="coalition-place-name">{place?.name ?? 'Choose a council'}</span><Icon name="chevronDown" size={18}/></button></h1>
        <button type="button" class="coalition-random" data-coalition-random data-current-council={municipality?.id} aria-label="Play a random municipality"><img class="chaos-random-die" src="/images/coalition/random-die-pixel.webp" width="32" height="32" alt=""/><span data-random-label>Random</span></button>
      </div>
      <p class="coalition-random-feedback" data-random-feedback role="status" hidden></p>
    </header>
    <CoalitionPicker provinceId={province?.id} councilId={municipality?.id}/>
    {model && seats && seats.status !== 'unavailable' && municipality ? <>
      {dataNotice && <p class="notice coalition-delay">{dataNotice}</p>}
      <CoalitionGame model={model}/>
      <p class="sr-only" data-coalition-announcement role="status" aria-live="polite"></p>
      {place && <GetInvolved place={place}/>}
      <CoalitionStory model={model}/>
      <div class="coalition-context"><details><summary>Rules, real politics &amp; sources</summary><ResultStatus result={municipality} showDelay={!localSnapshot}/><SeatMethod seats={seats} result={municipality}/><p class="small">Tap parties to reach {model.majority} seats, then roll the dice for one fictional scenario. Every roll starts from your original deal. Previously drawn scenarios stay out of the deck until the applicable cards run out. Every party follows the same rules. A “key partner” is one whose departure would put your deal below the majority target. Plot twists do not change the real results or your selection.</p><p class="small">A seat majority does not confirm a governing agreement. The game uses a fixed majority of all council seats; real council votes can involve different attendance and voting rules. The caricatures represent national party leaders, not local candidates.</p><p class="small">Inspired by the kingmaker politics and shifting alliances documented in <a href="https://coalitions.mistra.org.za/">MISTRA’s Coalitions Barometer</a>. In May 2023, Johannesburg elected Al Jama-ah’s Kabelo Gwamanda mayor with 139 votes: a small party can win a very big chair. <a href="https://joburg.org.za/media_/Pages/Media/Media%20Statements/2023%20Media%20Statements/May/Joburg-elects-the-Executive-Mayor.aspx">City record ↗</a></p></details></div>
      <noscript><p class="notice">Enable JavaScript to select parties. <a href={resultUrl}>View council seats</a>.</p></noscript>
    </> : <section class="empty coalition-waiting"><p class="eyebrow">{failed ? 'Data unavailable' : validCouncil ? 'Council allocation pending' : 'Council not found'}</p><h2>{failed ? 'We couldn’t load this council’s seats.' : validCouncil ? 'This council isn’t ready to play yet.' : 'Choose a whole municipality to play.'}</h2><p>{failed ? 'Please try again. You can also choose another council.' : seats?.status === 'unavailable' ? seats.reason : 'The builder needs a complete reported or estimated seat breakdown.'}</p>{validCouncil && !failed && <p>This page will update when usable seats become available.</p>}<div class="links">{failed && <a class="button" href={Astro.url.pathname}>Try again</a>}<button type="button" class="button primary" data-coalition-picker-open="councils" aria-haspopup="dialog" aria-controls="coalition-picker">Choose another council →</button>{validCouncil && <a class="button" href={resultUrl}>View latest results</a>}</div></section>}
    {validCouncil && place && !model && <GetInvolved place={place}/>}
  </section>
  {validCouncil && place && <CouncilGovernment municipalityId={place.relationships.find(r=>r.election===2026&&r.level==='municipality'&&r.relation==='equals')!.areaId} result={municipality} builder/>}
  {validCouncil && place && <RelatedNews scope="coalition" area={place.slug}/>}
</Site>
<script>import '../../../../lib/seats/client.ts';</script>
