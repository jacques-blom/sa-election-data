---
import { env } from 'cloudflare:workers';
import { mapLink } from '../../../lib/maps/config.ts';
import { administrative } from '../../../lib/maps/administrative.ts';
import Site from '../../../layouts/Site.astro';
import RegionMap from '../../../components/RegionMap.astro';
import ResultChart from '../../../components/ResultChart.astro';
import PlaceSearch from '../../../components/PlaceSearch.astro';
import AddressResult from '../../../components/AddressResult.astro';
import Wards from '../../../components/Wards.astro';
import CouncilSeats from '../../../components/CouncilSeats.astro';
import '../../../styles/municipality.css';
import { placeUrl, places } from '../../../lib/places/catalogue.ts';
import { findDirectoryPlace } from '../../../lib/places/directory.ts';
import { getPlaceResults,type PlaceResults } from '../../../lib/places/results.ts';
import { provinces,provinceUrl } from '../../../lib/overview/results.ts';
let place:Awaited<ReturnType<typeof findDirectoryPlace>>;let data:PlaceResults|null=null;let failed=false;
try{place=await findDirectoryPlace(env.GEOGRAPHY_DB??env.RESULTS_DB,Astro.params.slug??'');if(place)data=await getPlaceResults(env.RESULTS_DB,place,env.RAW_RESULTS);}catch{failed=true;}
Astro.response.status=failed?503:!place?404:!data?.municipality?503:200;
Astro.response.headers.set('Cache-Control',Astro.response.status===200?'public, max-age=15, s-maxage=15':'no-store');
if(Astro.response.status===503)Astro.response.headers.set('Retry-After','60');
const ballot=Astro.url.searchParams.get('ballot')==='ward'?'ward':'pr';
const parentIds=place?.relationships.filter(r=>r.level==='municipality'&&r.election===2026).map(r=>r.areaId)??[];
const parents=places.filter(p=>p.relationships.some(r=>r.level==='municipality'&&r.relation==='equals'&&parentIds.includes(r.areaId)));
const town=place?.kind==='town'||place?.kind==='suburb';
const province=provinces.find(p=>p.name===place?.province);
const boundary=place?.geometry;
---
<Site liveResults={Astro.response.status !== 404} title={place?`${place.name} election results 2026`:'Area not found'} description={place?.description??'Find local election results by place name.'} noindex={!place?.indexable||Astro.response.status!==200}>
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">South Africa</a>{province&&<><span>/</span><a href={provinceUrl(province)}>{province.name}</a></>}{town&&parents.length===1&&<><span>/</span><a href={placeUrl(parents[0]!)}>{parents[0]!.name}</a></>}</nav>
{place?<>
<div class="page-top"><div><p class="eyebrow">{place.province} · {place.kind==='metro'?'Metropolitan municipality':place.kind} · 2026</p><h1>{place.name}</h1></div></div>

{town&&<p class="notice">These results cover the whole wards overlapping {place.name}, including areas outside the town. There is no separate town-only result.</p>}
{data?.municipality?<>
{!town&&<CouncilSeats result={data.municipality} href={placeUrl(place)}/>}
{!town?<div class="results-layout municipality-results">
  <ResultChart result={data.municipality} ballot={ballot}/>
  <aside class="municipality-tools" aria-label="Map and address lookup">
    {place.bbox&&boundary&&<RegionMap compact options={{bbox:place.bbox,level:boundary.level,id:boundary.id,code:administrative.municipalities[boundary.id]?.code}} title={`${place.name} and its wards`} href={mapLink(place.slug)} caption="Select a ward to see its results."/>}
    <section id="find-your-ward" class="card municipality-ward-finder" data-address-lookup aria-labelledby="ward-address-heading">
      <h2 id="ward-address-heading">Find your ward by address</h2>
      <PlaceSearch id="municipality-address" mode="address" action="/search" compact area={place.bbox ? {name:place.name,bbox:place.bbox} : undefined}/>
      <AddressResult/>
      <p class="small address-privacy">Google receives your search. Counted doesn’t save your address. <a href="/privacy">Privacy</a></p>
      <div class="links"><a href="#wards">Browse all {data.wards.length} wards ↓</a></div>
      <noscript><p class="small">Address search needs JavaScript. Browse the wards below or <a href="/search">search by area name</a>.</p></noscript>
    </section>
  </aside>
</div>:null}
<Wards preview={town} searchable={town} wards={data.wards} title={town?`Ward results around ${place.name}`:'Ward results'} note={town?'Whole-ward results':'Ward ballot'}/>
{town&&place.bbox&&boundary&&<RegionMap options={{bbox:place.bbox,level:boundary.level,id:boundary.id,wardIds:place.relationships.filter(r=>r.level==='ward').map(r=>r.areaId)}} title={`${place.name} and its wards`} href={mapLink(place.slug)} caption="Dashed outline: statistical place boundary. Shaded areas: overlapping wards. Select a ward."/>}
{town&&<section class="card scope-card"><div class="card-heading"><h2>Which results cover {place.name}?</h2></div>{place.boundaryContext?.notes.map(note=><p>{note}</p>)}<div class="links">{parents.map(parent=><a href={placeUrl(parent)}>Whole {parent.name} council result ↗</a>)}<a href="/find-address">Find the ward at your address →</a></div><details><summary>How we matched this place to wards</summary><p>{place.boundaryContext?.method}</p><ul>{place.sources.map(s=><li><a href={s.url}>{s.label} ↗</a></li>)}</ul></details></section>}
{data.missingWardIds.length>0&&<p class="notice">Results are not available for mapped wards: {data.missingWardIds.join(', ')}.</p>}

</>:<section class="empty"><h2>Results are temporarily unavailable.</h2><p>Please try again shortly.</p><a href={place.sources[0]?.url}>View the source →</a></section>}
</>:<section class="empty"><h1>{failed?'Results are temporarily unavailable.':'Area not found.'}</h1><a href="/search">Find your area →</a></section>}
</Site>
