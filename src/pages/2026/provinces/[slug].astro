---
import { env } from 'cloudflare:workers';
import Site from '../../../layouts/Site.astro';
import RegionMap from '../../../components/RegionMap.astro';
import { administrative } from '../../../lib/maps/administrative.ts';
import SummaryResults from '../../../components/overview/SummaryResults.astro';
import MunicipalityCard from '../../../components/overview/MunicipalityCard.astro';
import { provinces, provinceUrl, getProvinceOverview, progressOf, municipalBallot, overviewPartyStyle, matchesMunicipality } from '../../../lib/overview/results.ts';
import '../../../styles/overview.css';
const province = provinces.find(p => p.slug === Astro.params.slug);
let data: Awaited<ReturnType<typeof getProvinceOverview>> | null = null;
if (province) try { data = await getProvinceOverview(env.RESULTS_DB,province, env.RAW_RESULTS); } catch(error) { console.error('Province overview unavailable',error); }
Astro.response.status = !province ? 404 : data ? 200 : 503;
Astro.response.headers.set('Cache-Control',data ? 'public, max-age=15, s-maxage=15' : 'no-store');
if (Astro.response.status === 503) Astro.response.headers.set('Retry-After','60');
const query = (Astro.url.searchParams.get('q') ?? '').slice(0,100).trim();
const shown = data?.municipalities.filter(m => matchesMunicipality(m,query)).length ?? 0;
const councils = data ? progressOf(data.summary,'municipalities') : null;

---
<Site liveResults={Astro.response.status !== 404} title={province ? `${province.name} election results 2026` : 'Province not found'} description={province ? `See 2026 local election party vote shares in ${province.name}, then explore municipal PR results and local leaders.` : 'Browse South African local election results by province.'} noindex={!data || !!query}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">South Africa</a><span aria-hidden="true">/</span><span aria-current="page">{province?.name ?? 'Province not found'}</span></nav>
  {province ? <>
    <header class="overview-province-heading"><div><p class="eyebrow">2026 local elections</p><h1>{province.name}</h1><p>{councils ? `${councils.expected} metro and local municipalities` : 'Municipality election results'}</p></div></header>

    {data ? <>
      <div class="overview-results-layout"><SummaryResults result={data.summary} name={province.name}/>    {administrative.provinces[province.id]&&<RegionMap options={{level:'province',id:province.id,bbox:administrative.provinces[province.id]!.bbox,colors:data?.municipalities.map(m=>({id:m.id,color:municipalBallot(m.result).leader ? overviewPartyStyle(municipalBallot(m.result).leader!.party_name)[1] : '#dce1d5'}))}} title={`${province.name} and its municipalities`} caption="Municipal PR leaders · select a municipality"/>}</div>
      <section class="overview-municipalities" aria-labelledby="municipality-heading"><div class="overview-section-heading"><div><h2 id="municipality-heading">Municipality results</h2><p>Municipal PR votes</p></div></div>
        <form action={`${provinceUrl(province)}#municipality-heading`} method="get" class="overview-directory-filter" role="search"><label for="municipality-query">Find a municipality</label><div><input id="municipality-query" name="q" type="search" value={query} maxlength="100" placeholder="Name or municipal code"/><button class="button" type="submit">Filter</button></div><p role="status" aria-live="polite" data-result-count>{shown} of {data.municipalities.length} municipalities</p></form>
        {councils && data.municipalities.length !== councils.expected && <p class="overview-warning">Results available for {data.municipalities.length} of {councils.expected} municipalities.</p>}
        <div class="overview-municipality-grid">{data.municipalities.map(m => <div class="overview-municipality-wrapper" hidden={!matchesMunicipality(m,query)}><MunicipalityCard municipality={m}/></div>)}</div>
        <p class="overview-empty" data-no-municipalities hidden={shown > 0}>No matching municipality. Try a different name or clear the filter.</p>
      </section>
    </> : <section class="overview-unavailable" role="status"><h2>Results are temporarily unavailable.</h2><p>We couldn’t load the province results. Please try again shortly.</p><div class="links"><a href={provinceUrl(province)}>Try again ↻</a><a href="https://results.elections.org.za/dashboards/lge/LGEResultsDashboard.aspx">View IEC results ↗</a></div></section>}
    <nav class="overview-other-provinces" aria-label="Other provinces"><h2>Explore another province</h2><div>{provinces.filter(p=>p.id!==province.id).map(p=><a href={provinceUrl(p)}>{p.name} ↗</a>)}</div></nav>
  </> : <section class="overview-unavailable"><h1>Province not found.</h1><p>Browse the nine provinces to find local election results.</p><a class="button" href="/#provinces">Choose a province →</a></section>}
</Site>
<script>
  const initialized = new WeakSet<HTMLFormElement>();
  function setupFilter() {
    const form = document.querySelector<HTMLFormElement>('.overview-directory-filter');
    if (!form) return;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const normal = (text:string) => text.normalize('NFKD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
    function filter() {
      const wrappers = [...document.querySelectorAll<HTMLElement>('.overview-municipality-wrapper')];
      const words = normal(input.value).split(' ').filter(Boolean);
      let count = 0;
      wrappers.forEach(wrapper => {
        const card = wrapper.querySelector<HTMLElement>('[data-search-name]')!;
        const match = words.every(word => normal(card.dataset.searchName ?? '').includes(word));
        wrapper.hidden = !match;
        if (match) count++;
      });
      form!.querySelector('[data-result-count]')!.textContent = `${count} of ${wrappers.length} municipalities`;
      document.querySelector<HTMLElement>('[data-no-municipalities]')!.hidden = count > 0;
    }
    filter();
    if (initialized.has(form)) return;
    initialized.add(form);
    input.addEventListener('input',filter);
    form.addEventListener('submit',event => { event.preventDefault(); filter(); const url = new URL(location.href); if (input.value.trim()) url.searchParams.set('q',input.value.trim()); else url.searchParams.delete('q'); history.replaceState(null,'',url); });
    function revealHash() {
      const target = document.getElementById(location.hash.slice(1));
      if (target?.hasAttribute('data-municipality-card')) {
        if (target.parentElement?.hidden) { input.value=''; filter(); }
        const detail = target.querySelector('details'); if (detail) detail.open = true;
        target.scrollIntoView({block:'start'});
      }
    }
    revealHash(); window.addEventListener('hashchange',revealHash);
  }
  setupFilter();
  document.addEventListener('results:updated',setupFilter);
</script>
