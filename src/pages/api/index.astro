---
import { Content, getHeadings } from '../../../docs/api.md';
import Brand from '../../components/Brand.astro';

const sections = getHeadings().filter((heading) => heading.depth === 2);
const title = 'API documentation · Counted';
const description = 'Use South African local election results in your own apps and research. Public endpoints, examples, historical data and source freshness explained.';
const canonical = new URL('/api', Astro.url.origin).href;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href="/api.md" title="API documentation as Markdown" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="Counted" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#documentation">Skip to documentation</a>
    <header>
      <Brand />
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/api" aria-current="page">API docs</a>
      </nav>
    </header>
    <div class="layout">
      <aside>
        <nav aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ul>{sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ul>
        </nav>
        <div class="resources">
          <a href="/api.md">Read as Markdown ↗</a>
          <a href="/api/v1">Open the JSON API ↗</a>
          <a href="/api/v1/sync">Check sync health ↗</a>
        </div>
      </aside>
      <main id="documentation">
        <p class="eyebrow">For developers, researchers & curious people</p>
        <article><Content /></article>
        <footer>
          Independent of the IEC. Always check a result’s source and freshness before using it.
          <a href="#documentation">Back to top ↑</a>
        </footer>
      </main>
    </div>
  </body>
</html>

<style>
  :global(html) { font-family: system-ui, sans-serif; color: #183d32; background: #f6f5ef; }
  :global(body) { margin: 0; }
  :global(*) { box-sizing: border-box; }
  :global(a) { color: #205f49; text-underline-offset: 0.2em; }
  :global(a:hover) { color: #0b3929; }
  :global(:focus-visible) { outline: 3px solid #3576b1; outline-offset: 4px; }
  .skip { position: absolute; left: 1rem; top: -5rem; padding: 1rem; background: white; z-index: 1; }
  .skip:focus { top: 1rem; }
  header { max-width: 76rem; margin: auto; padding: 1.5rem 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; border-bottom: 1px solid #ced8cd; }
  header nav { display: flex; gap: 1.5rem; font-size: 0.9rem; }
  header nav a { text-decoration: none; }
  header nav a[aria-current] { text-decoration: underline; font-weight: 650; }
  .layout { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 4rem; max-width: 76rem; margin: auto; padding: 3.5rem 2rem 4rem; }
  aside { position: sticky; top: 2rem; align-self: start; font-size: 0.9rem; }
  .eyebrow { color: #4b6258; font-size: 0.7rem; font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.6; }
  aside ul { list-style: none; padding: 0; margin: 1rem 0 1.75rem; }
  aside li { margin: 0.3rem 0; }
  aside a { display: block; padding: 0.4rem 0; text-decoration: none; line-height: 1.5; }
  aside a:hover { text-decoration: underline; }
  .resources { border-top: 1px solid #ced8cd; padding-top: 1rem; font-size: 0.8rem; }
  main { min-width: 0; max-width: 50rem; }
  article { line-height: 1.8; overflow-wrap: anywhere; }
  article :global(h1) { font-size: clamp(2rem, 4.5vw, 3.4rem); letter-spacing: -0.045em; line-height: 1.12; margin: 1rem 0 1.75rem; }
  article :global(h2) { font-size: 1.7rem; letter-spacing: -0.025em; line-height: 1.3; margin: 3rem 0 1rem; padding-top: 1.5rem; border-top: 1px solid #ced8cd; scroll-margin-top: 1rem; }
  article :global(h3) { font-size: 1.15rem; margin: 2rem 0 0.75rem; }
  article :global(p) { margin: 0 0 1.2rem; }
  article :global(ul) { padding-left: 1.25rem; }
  article :global(li) { margin: 0.8rem 0; }
  article :global(code) { font-size: 0.86em; background: #e8eddf; border-radius: 0.25rem; padding: 0.15em 0.3em; }
  article :global(pre) { max-width: 100%; padding: 1.35rem; border-radius: 0.75rem; overflow-x: auto; line-height: 1.7; }
  article :global(pre code) { background: transparent; padding: 0; border-radius: 0; }
  article :global(table) { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 1.5rem 0; }
  article :global(th), article :global(td) { text-align: left; vertical-align: top; border-bottom: 1px solid #ced8cd; padding: 0.75rem; }
  article :global(th) { background: #e8eddf; }
  footer { margin-top: 3rem; border-top: 1px solid #ced8cd; padding-top: 1.5rem; font-size: 0.8rem; line-height: 1.7; color: #4b6258; }
  footer a { display: block; margin-top: 0.75rem; }
  @media (max-width: 760px) {
    header { padding: 1.25rem; }
    .layout { display: block; padding: 1.5rem 1.25rem 3rem; }
    aside { position: static; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #ced8cd; }
    aside ul { display: flex; flex-wrap: wrap; column-gap: 1.25rem; margin: 0; }
    .resources { display: flex; flex-wrap: wrap; column-gap: 1.25rem; margin-top: 0.75rem; border: 0; padding: 0; }
    article :global(h2) { font-size: 1.5rem; }
  }
  @media (max-width: 380px) { header { align-items: start; flex-direction: column; gap: 0.75rem; } }
</style>
