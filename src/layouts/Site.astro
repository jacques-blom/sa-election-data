---
import '../styles/site.css';
import '../styles/history.css';
import '../styles/design.css';
import '../styles/patterns.css';
import '../styles/party-logos.css';
import Brand from '../components/Brand.astro';
import Analytics from '../components/Analytics.astro';
import ShareDialog from '../components/ShareDialog.astro';
import SocialImage from '../components/SocialImage.astro';
import HeaderSearch from '../components/HeaderSearch.astro';
import { publicUrl } from '../lib/site.ts';
interface Props { title: string; description: string; noindex?: boolean; canonicalPath?: string; liveResults?: boolean; mobileSearchHeader?: boolean }
const { title, description, noindex = false, canonicalPath = Astro.url.pathname, liveResults = false, mobileSearchHeader = false } = Astro.props;
const canonical = publicUrl(canonicalPath);
---
<!doctype html><html lang="en-ZA"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"/>
<title>{title} · Counted</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'}/><meta property="og:site_name" content="Counted"/><meta property="og:title" content={`${title} · Counted`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/>
<SocialImage canonical={canonical} title={title} description={description}/>
<link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png"/>
<link rel="icon" type="image/png" sizes="64x64" href="/brand/favicon-64.png"/>
<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg"/>
<link rel="preload" href="/fonts/SpaceGrotesk.ttf" as="font" type="font/ttf" crossorigin/>
<meta name="google-site-verification" content="eVs-cxyz0lIxH285ytquSvxggCU2uvMhVl8qfdCP1qo"/>
<Analytics/>
</head><body class:list={{ 'mobile-search-header': mobileSearchHeader }}><a class="skip" href="#main">Skip to results</a>{Astro.slots.has('header') ? <slot name="header"/> : <header class="header"><div class="header-inner">
<Brand />
<nav class="nav" aria-label="Main navigation"><a href="/" class:list={{active: Astro.url.pathname === '/' || Astro.url.pathname.includes('/places/') || Astro.url.pathname.includes('/wards/')}} aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Councils</a><a href="/national-results" class:list={{active: Astro.url.pathname === '/national-results' || /^\/\d{4}(?:\/provinces\/|$)/.test(Astro.url.pathname)}} aria-current={Astro.url.pathname === '/national-results' ? 'page' : undefined}>National results</a><a href="/highlights" class:list={{active: Astro.url.pathname === "/highlights"}} aria-current={Astro.url.pathname === "/highlights" ? "page" : undefined}>Highlights</a><a href="/map" class:list={{active: Astro.url.pathname === '/map'}} aria-current={Astro.url.pathname === '/map' ? 'page' : undefined}>Explore map</a></nav>{Astro.url.pathname !== '/' && <HeaderSearch/>}</div></header>}
<main id="main" data-live-results={liveResults ? '' : undefined}><slot/></main><footer class="footer"><div><p><strong>Counted</strong> · South African election results</p><p>Independent civic project · IEC results are provisional.</p><p id="live-results-status" role="status" hidden></p></div><div class="footer-links"><a href="/places">Browse all places</a><a href="/ai">Use Counted with AI</a><a href="/api">API & data docs</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/disclaimer">Disclaimer</a><a href="https://results.elections.org.za/dashboards/lge/LGEResultsDashboard.aspx">IEC source ↗</a></div></footer><ShareDialog/></body></html>
<script>import '../lib/live/results.ts'; import '../lib/news/client.ts';</script>
