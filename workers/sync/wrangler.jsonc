{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sa-election-data-sync",
  "account_id": "1644a80d2d9ee897e4a990ce1e8100ee",
  "main": "index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "limits": { "cpu_ms": 30000 },
  "d1_databases": [{
    "binding": "RESULTS_DB",
    "database_name": "sa-election-data",
    "database_id": "95ad93f9-e5f0-4a0e-b7c2-74bde7e3b91b",
    "preview_database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../../migrations"
  }],
  "r2_buckets": [{ "binding": "RAW_RESULTS", "bucket_name": "sa-election-data-raw" }],
  "queues": {
    "producers": [{ "binding": "RESULT_JOBS", "queue": "sa-election-data-refresh" }],
    "consumers": [{
      "queue": "sa-election-data-refresh",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_concurrency": 3,
      "max_retries": 5,
      "retry_delay": 60,
      "dead_letter_queue": "sa-election-data-failed"
    }]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
