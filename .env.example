# Browser key restricted to this website; enable Places API (New) + Maps JavaScript API.
PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only Google News access through SerpAPI. Set the same Worker secret for deployment.
SERPAPI_API_KEY=

# Personal OpenRouter account only. Server secret; never prefix with PUBLIC_.
# Wrangler loads this server-only key from the local .env file in both environments.
# Apply migration 0009, then pnpm dev:chat previews chat without SerpAPI. See docs/chat.md.
OPENROUTER_API_KEY=

# Optional comma-separated hostnames for accessing a remote development server.
DEV_ALLOWED_HOSTS=
