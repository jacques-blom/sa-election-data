{
  "name": "sa-election-data",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare": "pnpm cf:types && astro sync",
    "dev": "astro dev",
    "check": "pnpm cf:types && astro check",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cf:types": "wrangler types && wrangler types sync-worker-configuration.d.ts --config workers/sync/wrangler.jsonc --env-interface SyncEnv --include-runtime false && wrangler types usage-worker-configuration.d.ts --config workers/usage/wrangler.jsonc --env-interface UsageEnv --include-runtime false",
    "data:ingest": "node scripts/ingest.ts",
    "data:reprocess": "node scripts/reprocess.ts",
    "data:load": "node scripts/load-local.ts",
    "data:export": "node scripts/export.ts",
    "test": "node --test tests/*.test.ts",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "deploy": "pnpm build && wrangler deploy --profile personal",
    "sync:dev": "wrangler dev --config workers/sync/wrangler.jsonc --test-scheduled",
    "sync:dry-run": "wrangler deploy --config workers/sync/wrangler.jsonc --dry-run",
    "sync:deploy": "wrangler deploy --config workers/sync/wrangler.jsonc --profile personal",
    "usage:report": "node scripts/usage.ts",
    "usage:deploy": "wrangler deploy --config workers/usage/wrangler.jsonc --profile personal"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.157.0"
  }
}
