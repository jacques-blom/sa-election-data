{
  "name": "sa-election-data",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare": "pnpm cf:types && astro sync",
    "dev": "astro dev",
    "check": "pnpm cf:types && astro check",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cf:types": "wrangler types",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "deploy": "pnpm build && wrangler deploy --profile personal"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.157.0"
  }
}
